# ==============================================================================
# App Gateway (Apollo Federation) — Multi-stage Dockerfile
# ==============================================================================

# --- Stage 1: Builder ---
FROM docker.io/library/node:20-alpine AS builder

WORKDIR /app

COPY core /app/core
COPY services/gateway/package*.json ./
RUN npm ci --legacy-peer-deps

COPY core /app/core
COPY services/gateway/ ./

# --- Stage 2: Development ---
FROM docker.io/library/node:20-alpine AS development

WORKDIR /app

COPY core /app/core
COPY services/gateway/package*.json ./
RUN npm install --legacy-peer-deps --prefer-offline --no-audit --progress=false

COPY core /app/core
COPY services/gateway/ .

EXPOSE 4000

CMD ["node", "index.js"]

# --- Stage 3: Production ---
FROM docker.io/library/node:20-alpine AS production

WORKDIR /app

RUN addgroup -S bsopt && adduser -S bsopt -G bsopt

COPY --from=builder /app/package*.json ./
RUN npm ci --omit=dev --legacy-peer-deps

COPY --from=builder /app/*.js ./
COPY --from=builder /app/eslint.config.js ./

RUN chown -R bsopt:bsopt /app
USER bsopt

EXPOSE 4000

ENV NODE_ENV=production

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:4000/health || exit 1

CMD ["node", "index.js"]
