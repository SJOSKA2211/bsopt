# Production Dockerfile for the BS-Opt Scraper Service
# Stage 1: Build dependencies
FROM docker.io/library/python:3.12-slim-bookworm AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
RUN pip install --no-cache-dir uv
ENV UV_HTTP_TIMEOUT=300
ENV UV_RETRIES=10

# Copy requirements and install
COPY requirements.txt .
RUN uv pip install --no-cache --system -r requirements.txt \
    && uv pip install --no-cache --system playwright structlog

# Stage 2: Runtime image
FROM docker.io/library/python:3.12-slim-bookworm

WORKDIR /app

# Install runtime dependencies including Playwright system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    # Playwright system dependencies
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user
RUN groupadd -r bsopt && useradd -r -g bsopt bsopt

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Install browsers as root
ENV PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/ms-playwright
RUN playwright install chromium
RUN playwright install-deps chromium

# Copy source code
COPY core /app/core
COPY services /app/services
COPY pyproject.toml .

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONOPTIMIZE=2 \
    PYTHONPATH=/app \
    INSIDE_DOCKER=1 \
    PLAYWRIGHT_BROWSERS_PATH=/usr/local/share/ms-playwright \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317 \
    OTEL_SERVICE_NAME=bsopt-scraper

# Set permissions
RUN chown -R bsopt:bsopt /app && chown -R bsopt:bsopt /usr/local/share/ms-playwright

# Switch to non-root user
USER bsopt

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD python -c "import time; import sys; import os; sys.exit(0 if not os.path.exists('/tmp/scraper_heartbeat') or time.time() - float(open('/tmp/scraper_heartbeat').read().strip()) < 300 else 1)"

CMD ["python", "services/scrapers/concurrent_ingestion.py"]
