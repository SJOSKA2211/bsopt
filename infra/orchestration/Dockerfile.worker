# === Stage 1: Builder ===
FROM docker.io/library/python:3.12-slim-bookworm AS builder
RUN pip install uv

WORKDIR /app

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=0
ENV UV_LINK_MODE=copy
ENV UV_HTTP_TIMEOUT=300
ENV UV_RETRIES=10

RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY pyproject.toml requirements.txt ./

# Lightning-fast dependency resolution with cache mount
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install -r requirements.txt --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple

# Install Rust and build bsopt_core
RUN apt-get update && apt-get install -y --no-install-recommends curl build-essential
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
RUN uv pip install maturin
COPY core /app/core
COPY services /app/services
ENV RUSTFLAGS="-C target-cpu=native -C opt-level=3"
RUN cd services/quant/rust-core && maturin build --release --strip --out /tmp/wheels
RUN uv pip install /tmp/wheels/*.whl


# === Stage 2: Development ===
FROM docker.io/library/python:3.12-slim-bookworm AS development

WORKDIR /app 

# Install build dependencies for dev 
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy everything for dev (hot-reloading)
COPY . .

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["celery", "-A", "services.workers.tasks.celery_app", "worker", "-l", "info"]


# === Stage 3: Production ===
FROM docker.io/library/python:3.12-slim-bookworm AS production

WORKDIR /app

#  OPTIMIZED: Optimized performance flags
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONOPTIMIZE=2

# Create a non-root user for security
RUN groupadd -g 1000 appgroup && \
    useradd -r -u 1000 -g appgroup appuser && \
    apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R appuser:appgroup /app

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY core /app/core
COPY services /app/services
RUN chown -R appuser:appgroup /app

USER appuser

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["celery", "-A", "services.workers.tasks.celery_app", "worker", "-l", "info"]
