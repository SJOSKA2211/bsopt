# ==============================================================================
# Manifold: ENVIRONMENT TEMPLATE (Hardened v3.1)
# ==============================================================================
# NOTE: The bootstrap.sh script will automatically generate and encrypt
# sensitive variables below. Once encrypted as ENC_*, the plaintext version
# will be removed from this file for security at rest, but will be injected
# into the current session during bootstrap execution.
# ==============================================================================

# Application Base
ENVIRONMENT=dev
PROJECT_NAME="Black-Scholes Advanced Option Pricing Platform"
POSTGRES_DB=bsopt
POSTGRES_USER=admin
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database Connections
# Use port 5432 for PGBouncer internal, 6433 for host access
DATABASE_URL=postgresql://admin:password@pgbouncer:5432/bsopt
DATABASE_URL_TEST=postgresql://admin:password@postgres:5432/bsopt_test
DATABASE_URL_LOCAL=postgresql://admin:password@localhost:6433/bsopt

# Performance Tuning
PGBOUNCER_ENABLED=true
DATABASE_MIN_POOL_SIZE=20
DATABASE_MAX_POOL_SIZE=100
SLOW_QUERY_THRESHOLD_MS=100

# Redis & Broker
REDIS_URL=redis://:bsopt_redis_secret@redis:6379/0
RABBITMQ_USER=admin
RABBITMQ_HOST=rabbitmq
RABBITMQ_URL=amqp://admin:password@rabbitmq:5672//

# Auth & Services
BETTER_AUTH_URL=http://localhost:3001
JWT_ALGORITHM=RS256
JWT_RS256_PRIVATE=""
JWT_RS256_PUBLIC=""
JWT_ES256_PRIVATE=""
JWT_ES256_PUBLIC="LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0KTUZrd0V3WUhLb1pJemowQ0FRWUlLb1pJemowREFRY0RRZ0FFQ0tWZVFoVEVHUXRvVGMxNHJkUDVETHl1YXZEcgpsYTZkRlNSR2hiM3JNcEJ3ZUh4aTJTQ0d3U3pYSjQzUGMxKytKRmpvSTdJRjRva2JFZWM0UWpYSEFBPT0KLS0tLS1FTkQgUFVCTElDIEtFWS0tLS0tCg=="
MFA_TOTP_SECRET=secure_totp_master
BLOCKCHAIN_PRIVATE_KEY=0x_secure_hex_key
AUDIT_VAULT_KEY=32_byte_secure_string
IBM_QUANTUM_TOKEN=your_token_here

ENVIRONMENT=development
INSIDE_DOCKER=1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

ARGON2_SALT="09dfe25001ef72a7fe3587ce79b462f7"
ENC_POSTGRES_PASSWORD=""
ENC_REDIS_PASSWORD=""
ENC_JWT_SECRET=""
ENC_BETTER_AUTH_SECRET=""
ENC_RABBITMQ_PASSWORD=""
ENC_MINIO_ROOT_PASSWORD=""
PGBOUNCER_ADMIN_PASSWORD=12345678901234567890123456789012
AUDIT_VAULT_KEY=12345678901234567890123456789012
MINIO_ROOT_PASSWORD=12345678901234567890123456789012
