#!/usr/bin/env bash
set -euo pipefail

# ==
# BS-OPT: OMARCHY META-COGNITIVE BOOTSTRAP (v7.2)
# ==
# Orchestrates the sequential deployment and health-gating of the BSOPT cluster.

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_ROOT"

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# 1. Environment Generation (Strict & Secure)
ENV_FILE=".env"
if [ ! -f "$ENV_FILE" ]; then
    log_info "Generating cryptographically secure .env..."
    gen_secret() { head -c 32 /dev/urandom | base64 | tr -d '
' | tr -d '=' | head -c 32; }
    
    cat > "$ENV_FILE" <<EOF
ENVIRONMENT=production
DEBUG=false
POSTGRES_USER=manifold_admin
POSTGRES_PASSWORD=$(gen_secret)
POSTGRES_DB=bsopt
REDIS_PASSWORD=$(gen_secret)
JWT_SECRET=$(head -c 64 /dev/urandom | base64 | tr -d '
')
MFA_ENCRYPTION_KEY=$(gen_secret)
RABBITMQ_USER=manifold_mq
RABBITMQ_PASSWORD=$(gen_secret)
DATABASE_URL=postgresql+asyncpg://manifold_admin:${POSTGRES_PASSWORD}@pgbouncer:6432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672//
EOF
    log_success ".env generated."
fi

# 2. PKI Substrate (mTLS)
PKI_DIR=".pki"
mkdir -p "$PKI_DIR"

# Generate Root CA first
if [ ! -f "${PKI_DIR}/root_ca.key" ]; then
    log_info "Initializing PKI substrate: Generating Root CA..."
    openssl genrsa -out "${PKI_DIR}/root_ca.key" 4096 2>/dev/null
    openssl req -x509 -new -nodes -key "${PKI_DIR}/root_ca.key" -sha256 -days 3650 
        -out "${PKI_DIR}/root_ca.crt" 
        -subj "/C=US/ST=Security/L=BSOPT/O=Internal/CN=BSOPT-CA" 2>/dev/null
    log_success "Root CA generated."
else
    log_info "Root CA already exists."
fi

issue_cert() {
    local svc=$1
    local cert_path="${PKI_DIR}/${svc}.crt"
    local key_path="${PKI_DIR}/${svc}.key"

    if [ ! -f "$key_path" ]; then
        log_info "Issuing certificate for: $svc"
        openssl genrsa -out "$key_path" 2048 2>/dev/null
        openssl req -new -key "$key_path" -out "${PKI_DIR}/${svc}.csr" -subj "/C=US/O=BSOPT/CN=${svc}" 2>/dev/null
        
        # Ensure root CA files exist before using them
        if [ ! -f "${PKI_DIR}/root_ca.crt" ] || [ ! -f "${PKI_DIR}/root_ca.key" ]; then
            log_error "Root CA certificate or key not found. Cannot issue service certificate for $svc."
            exit 1
        fi

        openssl x509 -req -in "${PKI_DIR}/${svc}.csr" -CA "${PKI_DIR}/root_ca.crt" -CAkey "${PKI_DIR}/root_ca.key" 
            -CAcreateserial -out "$cert_path" -days 365 -sha256 2>/dev/null
        rm "${PKI_DIR}/${svc}.csr"
        log_success "Certificate issued for $svc."
    else
        log_info "Certificate already exists for $svc."
    fi
}
# Ensure all services that require mTLS have certificates issued
for s in auth_service api_service worker mlops gateway; do issue_cert "$s"; done

# 3. Docker Infrastructure & Orchestration
COMPOSE_FILE="infrastructure/docker-compose.yml"

deploy_step() {
    local svc=$1
    log_info "Deploying and health-gating: $svc..."
    docker compose -f "$COMPOSE_FILE" up -d --build "$svc"
    
    local retries=30
    # Use 'docker inspect' to check health status. Fallback to 'running' state if healthcheck is not yet 'healthy'.
    until [ "$(docker inspect -f '{{.State.Health.Status}}' "manifold-$svc" 2>/dev/null)" == "healthy" ] || 
          [ "$(docker inspect -f '{{.State.Status}}' "manifold-$svc" 2>/dev/null)" == "running" ] || 
          [ $retries -eq 0 ]; do
        sleep 2
        ((retries--))
        echo -n "."
    done
    echo ""
    
    # Final check after loop
    if ! docker compose -f "$COMPOSE_FILE" ps "$svc" --format json | grep -qE '"State":"running"|"Health":"healthy"'; then
        log_error "Service $svc failed to reach healthy state."
        docker compose -f "$COMPOSE_FILE" logs "$svc" | tail -n 20
        exit 1
    fi
    log_success "$svc is online."
}

# 4. Sequential Rollout
log_info "--- Starting Sequential Deployment ---"

log_info "--- Phase 1: Data Persistence Layer ---"
deploy_step "timescaledb"
deploy_step "redis"
deploy_step "rabbitmq"
deploy_step "pgbouncer" # Depends on timescaledb

log_info "--- Phase 2: Core Services Layer ---"
deploy_step "auth_service" # Depends on data persistence and PKI
deploy_step "api_service"   # Depends on auth_service, data persistence, PKI
deploy_step "worker"        # Depends on data persistence, auth_service, PKI, RabbitMQ
deploy_step "mlops"         # Depends on worker, auth_service, PKI

log_info "--- Phase 3: Edge Layer ---"
deploy_step "frontend"      # Depends on api_service
deploy_step "nginx"         # Depends on frontend and api_service

log_success "Sequential Deployment Complete. Manifold Cluster v7.2 is Online."
log_info "Next steps: Run integration and E2E tests."
