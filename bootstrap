#!/usr/bin/env bash
# ==============================================================================
# Omarchy: THE META-COGNITIVE BOOTSTRAP (v8.3 - Hardened CPU-Only)
# ==============================================================================
# Unified orchestrator for the BSOPT cluster deployment.
# Sequential, health-gated, and zero-mock.
# ==============================================================================

set -euo pipefail

# Configuration
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_ROOT"

FORCE_REBUILD=${FORCE_REBUILD:-0}
ENV_FILE=".env"
PKI_DIR=".pki"
COMPOSE_FILE="docker-compose.yml"

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

dc() { docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" "$@"; }

# 0. Prerequisite Check
check_prereq() {
    if ! command -v "$1" &> /dev/null; then
        log_error "$1 is not installed. Required for bootstrap."
        exit 1
    fi
}
check_prereq openssl
check_prereq docker

# 1. Environment Secrets Generation
if [ ! -f "$ENV_FILE" ]; then
    log_info "Generating secure .env file..."
    gen_secret() { openssl rand -hex 32; }
    
    DB_PASS=$(gen_secret)
    REDIS_PASS=$(gen_secret)
    RABBIT_PASS=$(gen_secret)
    JWT_SEC=$(openssl rand -hex 64)
    MFA_EN=$(openssl rand -base64 32)
    ACCESS_TOKEN_EXPIRE_MINUTES=15 # Explicitly set default value
    REFRESH_TOKEN_EXPIRE_DAYS=30 # Explicitly set default value

    cat > "$ENV_FILE" <<EOF
# --- CORE ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- DATA ---
POSTGRES_DB=bsopt
POSTGRES_USER=admin
POSTGRES_PASSWORD=$DB_PASS
REDIS_PASSWORD=$REDIS_PASS
REDIS_HOST=redis
REDIS_PORT=6379
DATABASE_URL=postgresql+asyncpg://admin:$DB_PASS@postgres:5432/bsopt
REDIS_URL=redis://:$REDIS_PASS@redis:6379/0

# --- MESSAGING ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=$RABBIT_PASS
RABBITMQ_HOST=rabbitmq
RABBITMQ_URL=amqp://guest:$RABBIT_PASS@rabbitmq:5672//
CELERY_BROKER_URL=amqp://guest:$RABBIT_PASS@rabbitmq:5672//

# --- SECURITY ---
JWT_SECRET=$JWT_SEC
JWT_ALGORITHM=RS256
MFA_ENCRYPTION_KEY=$MFA_EN
GRPC_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=$ACCESS_TOKEN_EXPIRE_MINUTES
REFRESH_TOKEN_EXPIRE_DAYS=$REFRESH_TOKEN_EXPIRE_DAYS
EOF
    log_success ".env file generated."
fi

# 2. PKI Substrate (Secure mTLS)
mkdir -p "$PKI_DIR"
if [ ! -f "${PKI_DIR}/root_ca.key" ]; then
    log_info "Initializing PKI Layer..."
    openssl genrsa -out "${PKI_DIR}/root_ca.key" 4096 2>/dev/null
    openssl req -x509 -new -nodes -key "${PKI_DIR}/root_ca.key" -sha256 -days 3650 
        -out "${PKI_DIR}/root_ca.crt" 
        -subj "/C=US/ST=Security/L=BSOPT/O=Internal/CN=BSOPT-CA" 2>/dev/null
fi

issue_cert() {
    local svc=$1
    if [ ! -f "${PKI_DIR}/${svc}.key" ]; then
        openssl genrsa -out "${PKI_DIR}/${svc}.key" 2048 2>/dev/null
        openssl req -new -key "${PKI_DIR}/${svc}.key" -out "${PKI_DIR}/${svc}.csr" -subj "/C=US/O=BSOPT/CN=${svc}" 2>/dev/null
        openssl x509 -req -in "${PKI_DIR}/${svc}.csr" -CA "${PKI_DIR}/root_ca.crt" -CAkey "${PKI_DIR}/root_ca.key" \
            -CAcreateserial -out "${PKI_DIR}/${svc}.crt" -days 365 -sha256 2>/dev/null
        rm "${PKI_DIR}/${svc}.csr"
    fi
}
for s in auth_api pricing_api postgres redis rabbitmq; do issue_cert "$s"; done

# 3. Protocol Synchronization
PROTO_DIR="protos"
GEN_DIR="src/shared/protos"
if [ -d "$PROTO_DIR" ] && ls "$PROTO_DIR"/*.proto &>/dev/null; then
    log_info "Synchronizing gRPC protocol buffers..."
    mkdir -p "$GEN_DIR"
    # Modified docker run command to use single quotes for sh -c and double quotes for internal variables.
    # Re-added '2>/dev/null || true' to suppress potential verbose output and allow script to proceed if protoc has minor issues.
    docker run --rm -v "$(pwd):/app" -w /app python:3.12.13-slim sh -c 'pip install -q grpcio-tools && python -m grpc_tools.protoc -I./protos --python_out="$GEN_DIR" --grpc_python_out="$GEN_DIR" protos/*.proto' 2>/dev/null || true
    touch "$GEN_DIR/__init__.py"
    sed -i 's/import \([^ ]*\)_pb2/from . import \1_pb2/g' "$GEN_DIR"/*_pb2*.py 2>/dev/null || true
else
    log_info "No .proto files found, skipping protobuf generation."
fi

# 4. Deployment Logic
deploy_and_validate() {
    local svc=$1
    local attempt=1
    local max_attempts=3
    
    while [ $attempt -le $max_attempts ]; do
        log_info "Deploying service: $svc (Attempt $attempt/$max_attempts)..."
        
        if [ "$FORCE_REBUILD" -eq 1 ]; then
            dc build "$svc" 2>/dev/null || true
        fi
        
        dc up -d --force-recreate "$svc"
        
        local retries=30
        log_info "Waiting for $svc to become ready..."
        
        local cid
        cid=$(dc ps -q "$svc" 2>/dev/null || echo "")
        
        if [ -z "$cid" ]; then
            log_error "Could not find container for $svc."
            ((attempt++))
            continue
        fi
        
        local is_ready=0
        local has_healthcheck
        has_healthcheck=$(docker inspect -f '{{if .State.Health}}true{{else}}false{{end}}' "$cid" 2>/dev/null || echo "false")
        
        if [ "$has_healthcheck" = "true" ]; then
            until [ "$(docker inspect -f '{{.State.Health.Status}}' "$cid" 2>/dev/null)" = "healthy" ] || [ $retries -eq 0 ]; do
                sleep 2
                ((retries--))
                echo -n "."
            done
            echo ""
            if [ "$(docker inspect -f '{{.State.Health.Status}}' "$cid" 2>/dev/null)" = "healthy" ]; then
                is_ready=1
            fi
        else
            until [ "$(docker inspect -f '{{.State.Status}}' "$cid" 2>/dev/null)" = "running" ] || [ $retries -eq 0 ]; do
                sleep 2
                ((retries--))
                echo -n "."
            done
            echo ""
            if [ "$(docker inspect -f '{{.State.Status}}' "$cid" 2>/dev/null)" = "running" ]; then
                is_ready=1
            fi
        fi
        
        if [ $is_ready -eq 1 ]; then
            log_success "$svc is online."
            return 0
        fi
        
        log_error "Attempt $attempt failed for $svc. Reading logs..."
        dc logs "$svc" | tail -n 50
        
        # CIRCUIT BREAKER: Cleanup before retry
        log_info "Circuit Breaker: Resetting service $svc..."
        dc stop "$svc" 2>/dev/null || true
        dc rm -f "$svc" 2>/dev/null || true
        
        ((attempt++))
        sleep 5
    done
    
    log_error "Service $svc failed after $max_attempts attempts. HALTING."
    exit 1
}

# 5. Execution Sequence
log_info "Starting Sequential Deployment (OMARCHY ABSOLUTE Protocol)..."

# Phase A: Persistence & Messaging
deploy_and_validate "timescaledb"
deploy_and_validate "redis"
deploy_and_validate "rabbitmq"
deploy_and_validate "pgbouncer"

# Phase B: Core Services
deploy_and_validate "auth_service"
deploy_and_validate "api_service"

# Phase C: Distributed Worker & MLOps
deploy_and_validate "worker"
deploy_and_validate "mlops"

# Phase D: Edge & Frontend
deploy_and_validate "frontend"
deploy_and_validate "nginx"

log_success "Deployment Complete. BSOPT Stack v10.0 is Healthy and Secure."
