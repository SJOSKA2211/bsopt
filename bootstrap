#!/usr/bin/env bash
# ==============================================================================
# Manifold: UNIFIED CONSOLIDATED BOOTSTRAP (v6.0)
# ==============================================================================
# Self-contained orchestrator for the BSOPT cluster deployment.
# ==============================================================================

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$PROJECT_ROOT"

# Flags
FORCE_REBUILD=${FORCE_REBUILD:-0}

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

log_info "Initializing BSOPT Consolidated Deployment (Modernized)..."

# 1. Environment Secrets Generation
ENV_FILE=".env"
if [ ! -f "$ENV_FILE" ]; then
    log_info "Generating secure .env file..."
    gen_secret() { head -c 32 /dev/urandom | base64 | tr -d '\n' | tr -d '=' | head -c 32; }
    
    DB_PASS=$(gen_secret)
    REDIS_PASS=$(gen_secret)
    RABBIT_PASS=$(gen_secret)
    JWT_SEC=$(head -c 64 /dev/urandom | base64 | tr -d '\n' | tr -d '=' | head -c 64)
    MFA_EN=$(head -c 32 /dev/urandom | base64 -w 0)

    cat > "$ENV_FILE" <<EOF
# --- CORE ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- DATA ---
POSTGRES_DB=bsopt
POSTGRES_USER=admin
POSTGRES_PASSWORD=$DB_PASS
REDIS_PASSWORD=$REDIS_PASS
REDIS_HOST=redis
REDIS_PORT=6379
DATABASE_URL=postgresql+asyncpg://admin:$DB_PASS@postgres:5432/bsopt
REDIS_URL=redis://:$REDIS_PASS@redis:6379/0

# --- MESSAGING ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=$RABBIT_PASS
RABBITMQ_HOST=rabbitmq
RABBITMQ_URL=amqp://guest:$RABBIT_PASS@rabbitmq:5672//
CELERY_BROKER_URL=amqp://guest:$RABBIT_PASS@rabbitmq:5672//

# --- SECURITY ---
JWT_SECRET=$JWT_SEC
JWT_ALGORITHM=RS256
MFA_ENCRYPTION_KEY=$MFA_EN
EOF
    log_success ".env file generated."
fi

# 2. PKI Substrate (Secure-by-Default mTLS)
PKI_DIR=".pki"
mkdir -p "$PKI_DIR"
if [ ! -f "${PKI_DIR}/root_ca.key" ]; then
    log_info "Initializing PKI Layer..."
    openssl genrsa -out "${PKI_DIR}/root_ca.key" 4096 2>/dev/null
    openssl req -x509 -new -nodes -key "${PKI_DIR}/root_ca.key" -sha256 -days 3650 \
        -out "${PKI_DIR}/root_ca.crt" \
        -subj "/C=US/ST=Security/L=BSOPT/O=Internal/CN=BSOPT-CA" 2>/dev/null
fi

issue_cert() {
    local svc=$1
    if [ ! -f "${PKI_DIR}/${svc}.key" ]; then
        openssl genrsa -out "${PKI_DIR}/${svc}.key" 2048 2>/dev/null
        openssl req -new -key "${PKI_DIR}/${svc}.key" -out "${PKI_DIR}/${svc}.csr" -subj "/C=US/O=BSOPT/CN=${svc}" 2>/dev/null
        openssl x509 -req -in "${PKI_DIR}/${svc}.csr" -CA "${PKI_DIR}/root_ca.crt" -CAkey "${PKI_DIR}/root_ca.key" \
            -CAcreateserial -out "${PKI_DIR}/${svc}.crt" -days 365 -sha256 2>/dev/null
        rm "${PKI_DIR}/${svc}.csr"
    fi
}
for s in auth_api pricing_api postgres redis rabbitmq; do issue_cert "$s"; done

# 3. Protocol Synchronization
log_info "Synchronizing gRPC protocol buffers..."
GEN_DIR="src/shared/protos"
mkdir -p "$GEN_DIR"
docker run --rm -v "$(pwd):/app" -w /app python:3.12.13-slim sh -c \
    "pip install grpcio-tools && python -m grpc_tools.protoc -I./protos --python_out=$GEN_DIR --grpc_python_out=$GEN_DIR protos/*.proto"
touch "$GEN_DIR/__init__.py"
sed -i 's/import \([^ ]*\)_pb2/from . import \1_pb2/g' "$GEN_DIR"/*_pb2*.py 2>/dev/null || true

# 4. Service Orchestration (Sequential)
COMPOSE_FILE="docker-compose.yml"

deploy_and_validate() {
    local svc=$1
    log_info "Deploying service: $svc..."
    if [ "$FORCE_REBUILD" -eq 1 ]; then
        docker compose -f "$COMPOSE_FILE" build "$svc"
    fi
    docker compose -f "$COMPOSE_FILE" up -d --force-recreate --remove-orphans "$svc"
    
    local retries=30
    log_info "Waiting for $svc to report healthy..."
    until docker compose -f "$COMPOSE_FILE" ps "$svc" --format json | grep -qE '"Health":"healthy"|"State":"running"' || [ $retries -eq 0 ]; do
        sleep 2
        ((retries--))
        echo -n "."
    done
    echo ""
    
    if ! docker compose -f "$COMPOSE_FILE" ps "$svc" --format json | grep -qE '"State":"running"'; then
        log_error "Service $svc failed to start."
        docker compose -f "$COMPOSE_FILE" logs "$svc" | tail -n 20
        exit 1
    fi
    log_success "$svc is online."
}

# Cleanup existing cluster if requested
if [ "$FORCE_REBUILD" -eq 1 ]; then
    log_info "Performing full cluster purge..."
    docker compose -f "$COMPOSE_FILE" down --remove-orphans || true
fi

# Phase 1: Infrastructure
log_info "--- Phase 1: Infrastructure ---"
deploy_and_validate "postgres"
deploy_and_validate "redis"
deploy_and_validate "rabbitmq"

# Phase 2: Core Cluster
log_info "--- Phase 2: Core services ---"
deploy_and_validate "auth_api"
deploy_and_validate "celery_worker"

log_success "Deployment Complete. Manifold Stack is v6.0 Online."
