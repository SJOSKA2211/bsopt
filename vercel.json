{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12"
      }
    },
    {
      "src": "src/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/src/frontend/$1",
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "src/frontend/index.html"
    }
  ],
  "env": {
    "PYTHONPATH": ".:src",
    "AUTH_SVC_ADDR": "auth-service-internal.manifold.test:50051",
    "ENVIRONMENT": "production"
  },
  "installCommand": "pip install --upgrade pip && pip install -r requirements.txt && npm install --production",
  "buildCommand": "cd src/frontend && npm run build"
}
