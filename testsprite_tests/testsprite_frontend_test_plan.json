  {
    "id": "TC006",
    "title": "GraphQL introspection succeeds after API login (valid credentials)",
    "description": "Verifies a user can log in via the API UI and then successfully execute a GraphQL introspection request using the received bearer token.",
    "category": "Developer Debugging Ports",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to the API documentation page for the authentication login endpoint."
      },
      {
        "type": "action",
        "description": "Type \"dev@example.com\" into the email field."
      },
      {
        "type": "action",
        "description": "Type \"password\" into the password field."
      },
      {
        "type": "action",
        "description": "Click the button to execute the login request."
      },
      {
        "type": "assertion",
        "description": "Verify text \"access_token\" is visible in the login response."
      },
      {
        "type": "action",
        "description": "Navigate to the API documentation page for the GraphQL endpoint."
      },
      {
        "type": "action",
        "description": "Type the Authorization header value in the format \"Bearer <access_token>\" using the token from the login response."
      },
      {
        "type": "assertion",
        "description": "Verify text \"__schema\" is visible in the GraphQL response."
      }
    ]
  },
  {
    "id": "TC007",
    "title": "GraphQL endpoint returns visible error for malformed query body",
    "description": "Verifies the GraphQL endpoint surfaces a user-visible error when a malformed request body is submitted via the UI.",
    "category": "Developer Debugging Ports",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to the API documentation page for the GraphQL endpoint."
      },
      {
        "type": "action",
        "description": "Type a clearly malformed GraphQL request body into the query/body field (for example, an incomplete JSON body or invalid GraphQL syntax)."
      },
      {
        "type": "action",
        "description": "Click the button to execute the GraphQL request."
      },
      {
        "type": "assertion",
        "description": "Verify text \"errors\" is visible in the GraphQL response."
      },
      {
        "type": "assertion",
        "description": "Verify text \"Syntax\" is visible in the GraphQL response."
      }
    ]
  },
