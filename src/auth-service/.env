ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO

# Database - Local Postgres (Native Features Only)
DATABASE_URL=postgresql://admin:password@localhost:5432/bsopt

# Redis (Local fallback)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ (Local fallback)
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Security (Safe defaults for dev)
JWT_SECRET=dev-secret-key-change-in-prod-please-verify
MFA_ENCRYPTION_KEY=dev-mfa-key-12345678901234567890123456789012
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_BASE_URL=http://localhost:3001
NODE_ENV=dev
