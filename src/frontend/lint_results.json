autoComplete=\"name\"\n          autoFocus\n          value={name}\n          onChange={(e) => setName(e.target.value)}\n          disabled={loading}\n          InputProps={{\n            startAdornment: (\n              <InputAdornment position=\"start\">\n                <PersonIcon sx={{ fontSize: 18, color: 'text.disabled' }} />\n              </InputAdornment>\n            ),\n          }}\n          sx={{ mt: 0 }}\n        />\n\n        <TextField\n          margin=\"normal\"\n          required\n          fullWidth\n          id=\"email\"\n          label=\"Email Address\"\n          name=\"email\"\n          type=\"email\"\n          autoComplete=\"email\"\n          value={email}\n          onChange={(e) => setEmail(e.target.value)}\n          disabled={loading}\n          InputProps={{\n            startAdornment: (\n              <InputAdornment position=\"start\">\n                <MailIcon sx={{ fontSize: 18, color: 'text.disabled' }} />\n              </InputAdornment>\n            ),\n          }}\n        />\n\n        <TextField\n          margin=\"normal\"\n          required\n          fullWidth\n          id=\"password\"\n          label=\"Password\"\n          name=\"password\"\n          type={showPassword ? 'text' : 'password'}\n          autoComplete=\"new-password\"\n          value={password}\n          onChange={(e) => setPassword(e.target.value)}\n          disabled={loading}\n          InputProps={{\n            startAdornment: (\n              <InputAdornment position=\"start\">\n                <LockIcon sx={{ fontSize: 18, color: 'text.disabled' }} />\n              </InputAdornment>\n            ),\n            endAdornment: (\n              <InputAdornment position=\"end\">\n                <IconButton\n                  size=\"small\"\n                  onClick={() => setShowPassword((s) => !s)}\n                  edge=\"end\"\n                  aria-label={showPassword ? 'Hide password' : 'Show password'}\n                >\n     