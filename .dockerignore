# Core ignores
.git
.gitignore
.env*
! .env.example
README.md
LICENSE
Makefile
PICKLE_RICK_PRD.md
*.md

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.venv*/
.venv_local/
pip-log.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/
.pytest_cache/

# Node
node_modules/
**/node_modules/
npm-debug.log
yarn-error.log

# Logs and Temp
*.log
logs/
tmp/
.gemini/
.gemini_security/
backups/

# ML Artifacts
mlflow.db
mlruns/
lightning_logs/
results/
models/

# Documentation
docs/
htmlcov/

# Build artifacts
dist/
build/
target/

# Explicit Inclusions (Must be last to override ignores, but we must re-ignore node_modules inside src if we include src)
!requirements*.txt
!pyproject.toml
!src/
!docker/

# Re-ignore node_modules specifically inside src just in case
src/**/node_modules/
