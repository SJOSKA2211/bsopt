FROM python:3.11-alpine

# Install dependencies for Celery worker
# Install RabbitMQ client and Redis client, along with build tools for potential C extensions
RUN apk add --no-cache 
    build-essential 
    rabbitmq-c-dev 
    librdkafka-dev 
    libpq-dev 
    postgresql-client 
    gcc 
    musl-dev 
    && rm -rf /var/cache/apk/*

# Set environment variables for Celery
ENV CELERY_BROKER_URL=redis://redis:6379/0
ENV CELERY_RESULT_BACKEND=redis://redis:6379/1
ENV CELERY_TIMEZONE=UTC
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

# Copy requirements first to leverage Docker layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy Celery specific requirements if any, or ensure they are in requirements.txt
# Example: If Celery needs specific packages not in base requirements.txt
# COPY requirements-celery.txt .
# RUN pip install --no-cache-dir -r requirements-celery.txt

# Copy the Celery application and worker code
COPY workers/tasks/celery_app.py ./workers/tasks/
COPY workers/webhook_worker.py ./workers/
COPY src ./src/

# Ensure any necessary configuration files are copied
# Example: COPY config/celery/celeryconfig.py ./config/

# Expose Celery Flower port if needed (optional, for monitoring)
# EXPOSE 5555

# Command to run the Celery worker
# Adjust worker name and concurrency as needed.
# '-P eventlet' or '-P gevent' can be used for better concurrency if installed.
CMD ["celery", "-A", "workers.tasks.celery_app", "worker", "--loglevel=INFO", "--concurrency=4", "-P", "solo"]
