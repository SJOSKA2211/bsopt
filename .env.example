# Unified Docker Environment Variables (High-Performance Optimized)
POSTGRES_DB=bsopt
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database Connections
# Use port 6432 for PGBouncer (Transactional Pooling)
DATABASE_URL=postgresql://admin:password@pgbouncer:6432/bsopt
DATABASE_URL_TEST=postgresql://admin:password@postgres:5432/bsopt_test
DATABASE_URL_LOCAL=postgresql://admin:password@localhost:5432/bsopt

# Performance Tuning
PGBOUNCER_ENABLED=true
DATABASE_MIN_POOL_SIZE=20
DATABASE_MAX_POOL_SIZE=100
SLOW_QUERY_THRESHOLD_MS=100

# Redis & Broker
REDIS_PASSWORD=bsopt_redis_secret
REDIS_URL=redis://:bsopt_redis_secret@redis:6379/0
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_HOST=rabbitmq
RABBITMQ_URL=amqp://admin:password@rabbitmq:5672//

# Auth & Services
BETTER_AUTH_SECRET=changeme_in_production
BETTER_AUTH_URL=http://localhost:3001
JWT_SECRET=changeme_in_production
JWT_ALGORITHM=RS256
JWT_RS256_PRIVATE=base64_encoded_private_key
JWT_RS256_PUBLIC=base64_encoded_public_key
JWT_ES256_PRIVATE=base64_encoded_private_key
JWT_ES256_PUBLIC=base64_encoded_public_key
MFA_TOTP_SECRET=secure_totp_master
BLOCKCHAIN_PRIVATE_KEY=0x_secure_hex_key
AUDIT_VAULT_KEY=32_byte_secure_string
IBM_QUANTUM_TOKEN=your_token_here

ENVIRONMENT=development
INSIDE_DOCKER=1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

