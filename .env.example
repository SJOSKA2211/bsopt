# ==============================================================================
# Manifold: ENVIRONMENT TEMPLATE (Hardened v3.1)
# ==============================================================================
# NOTE: The bootstrap.sh script will automatically generate and encrypt
# sensitive variables below. Once encrypted as ENC_*, the plaintext version
# will be removed from this file for security at rest, but will be injected
# into the current session during bootstrap execution.
# ==============================================================================

# Application Base
ENVIRONMENT=dev
PROJECT_NAME="Black-Scholes Advanced Option Pricing Platform"
POSTGRES_DB=bsopt
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database Connections
# Use port 5432 for PGBouncer internal, 6433 for host access
DATABASE_URL=postgresql://admin:password@pgbouncer:5432/bsopt
DATABASE_URL_TEST=postgresql://admin:password@postgres:5432/bsopt_test
DATABASE_URL_LOCAL=postgresql://admin:password@localhost:6433/bsopt

# Performance Tuning
PGBOUNCER_ENABLED=true
DATABASE_MIN_POOL_SIZE=20
DATABASE_MAX_POOL_SIZE=100
SLOW_QUERY_THRESHOLD_MS=100

# Redis & Broker
REDIS_PASSWORD=bsopt_redis_secret
REDIS_URL=redis://:bsopt_redis_secret@redis:6379/0
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_HOST=rabbitmq
RABBITMQ_URL=amqp://admin:password@rabbitmq:5672//

# Auth & Services
BETTER_AUTH_SECRET=changeme_in_production
BETTER_AUTH_URL=http://localhost:3001
JWT_SECRET=changeme_in_production
JWT_ALGORITHM=RS256
JWT_RS256_PRIVATE=base64_encoded_private_key
JWT_RS256_PUBLIC=base64_encoded_public_key
JWT_ES256_PRIVATE=base64_encoded_private_key
JWT_ES256_PUBLIC=base64_encoded_public_key
MFA_TOTP_SECRET=secure_totp_master
BLOCKCHAIN_PRIVATE_KEY=0x_secure_hex_key
AUDIT_VAULT_KEY=32_byte_secure_string
IBM_QUANTUM_TOKEN=your_token_here

# Market Data & Origins
MARKET_TICKER_SYMBOLS=SPY,QQQ,AAPL
NSE_NAME_SYMBOL_MAP='{"Safaricom": "SCOM"}'
NSE_SECTORS=Banking,Energy
TRUSTED_PROXIES=127.0.0.1,::1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

ENVIRONMENT=development
INSIDE_DOCKER=1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

