# Unified Docker Environment Variables
POSTGRES_DB=bsopt
POSTGRES_USER=admin
POSTGRES_PASSWORD=<your_postgres_password>
DATABASE_URL=postgresql://admin:<your_postgres_password>@postgres:5432/bsopt
DATABASE_URL_TEST=postgresql://admin:<your_postgres_password>@postgres:5432/bsopt_test
DATABASE_URL_LOCAL=postgresql://admin:<your_postgres_password>@localhost:5432/bsopt
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
BETTER_AUTH_SECRET=<your_auth_secret_here>
BETTER_AUTH_URL=http://localhost:3001
INSIDE_DOCKER=1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

