# Unified Test Environment Variables
ENVIRONMENT=test
DEBUG=true
LOG_LEVEL=DEBUG

# Point to containerized services for integration tests
# Use 'postgres' and 'redis' hostnames defined in docker-compose.yml
DATABASE_URL=postgresql://admin:password@postgres:5432/bsopt_test
REDIS_URL=redis://redis:6379/1

# Security
JWT_SECRET=test_secret_key_dont_use_in_prod
MFA_ENCRYPTION_KEY=kohPfvIxLq-vQaOw0uv9dLZmXWIrX29sLbuK84YRalU=

# Performance Tuning for Tests
NUMBA_DISABLE_JIT=1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# Flag for application logic to detect test environment
INSIDE_DOCKER=1
BSOPT_TEST_MODE=1
