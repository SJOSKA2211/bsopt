# Stage 1: Builder (Optimized for CI/Test speed)
FROM python:3.13-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uv
ENV PATH="/:/${PATH}"

WORKDIR /app

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1

# Copy project files for a complete install
COPY pyproject.toml requirements.txt ./

# Lightning-fast dependency resolution
# Install all extras [api, auth, ml, quant, distributed, dev]
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-cache -r requirements.txt \
    && uv pip install --system --no-cache ".[api,auth,ml,quant,distributed,dev]"

# Stage 2: Final CI/Test Image
FROM python:3.13-slim

WORKDIR /app

# Install runtime library dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy the entire project for testing
COPY . .

# Set testing environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV BSOPT_TEST_MODE=1
ENV PYTHONPATH=/app

# Default command for CI/Test runs
CMD ["pytest", "--cov=src", "--cov-report=term-missing"]
