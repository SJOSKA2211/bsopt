# Stage 1: Builder (Optimized for CI/Test speed)
FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Enable bytecode compilation and extend network timeouts for large ML packages
ENV UV_COMPILE_BYTECODE=1
ENV UV_HTTP_TIMEOUT=300
ENV UV_RETRIES=10

# Install system dependencies for building C extensions
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libpq-dev git curl \
    && rm -rf /var/lib/apt/lists/*

# Copy project files for a complete install
COPY pyproject.toml requirements.txt ./
COPY . .

# Install PyTorch first (CPU version for CI)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --index-url https://download.pytorch.org/whl/cpu \
    "torch>=2.5.0" \
    "torchvision" \
    "torchaudio"

# Install everything else from requirements.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r requirements.txt \
    --extra-index-url https://pypi.org/simple \
    && uv pip install --system ".[api,auth,ml,quant,distributed,dev]"

#  Build bsopt_core Rust extensions
RUN apt-get update && apt-get install -y --no-install-recommends curl
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
RUN uv pip install --system maturin
ENV RUSTFLAGS="-C target-cpu=native -C opt-level=3"
RUN cd src/core && maturin build --release --out /tmp/wheels
RUN uv pip install --system /tmp/wheels/*.whl

# Stage 2: Final CI/Test Image
FROM python:3.12-slim

WORKDIR /app

# Install runtime library dependencies
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 git curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy the entire project for testing
COPY . .

# Set testing environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV BSOPT_TEST_MODE=1
ENV PYTHONPATH=/app/src:/app
ENV NUMBA_DISABLE_JIT=1

# Default command for CI/Test runs
CMD ["pytest", "tests/"]
