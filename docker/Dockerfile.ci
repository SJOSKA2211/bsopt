# Stage 1: Builder (Optimized for CI/Test speed)
FROM python:3.13-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uv
ENV PATH="/:/${PATH}"

WORKDIR /app

# Enable bytecode compilation and extend network timeouts for large ML packages
ENV UV_COMPILE_BYTECODE=1
ENV UV_HTTP_TIMEOUT=300
ENV UV_RETRIES=10

# Copy project files for a complete install
COPY pyproject.toml requirements.txt ./
# We need to copy the source code to allow pip install . to work properly
# And we also need the rest of the files for the build context
COPY . .

# Lightning-fast dependency resolution
# Install all extras [api, auth, ml, quant, distributed, dev]
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-cache --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple -r requirements.txt \
    && uv pip install --system --no-cache ".[api,auth,ml,quant,distributed,dev]"

# Stage 2: Final CI/Test Image
FROM python:3.13-slim

WORKDIR /app

# Install runtime library dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy the entire project for testing
COPY . .

# Set testing environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV BSOPT_TEST_MODE=1
ENV PYTHONPATH=/app

# Default command for CI/Test runs
CMD ["pytest", "--cov=src", "--cov-report=term-missing"]
