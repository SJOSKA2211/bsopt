# === Stage 1: Builder ===
FROM python:3.13-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uv
ENV PATH="/:/${PATH}"

WORKDIR /app

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1
ENV UV_HTTP_TIMEOUT=300
ENV UV_RETRIES=10

COPY requirements.txt ./

# Install Python dependencies only in builder
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r requirements.txt \
    && uv pip install --system playwright


# === Stage 2: Development ===
FROM python:3.13-slim AS development

WORKDIR /app

# Install build dependencies for dev (including Playwright system deps)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    git \
    curl \
    # Playwright deps
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Install Playwright browsers natively in development stage
RUN playwright install --with-deps chromium

# Copy everything for dev (hot-reloading)
COPY . .

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["python", "src/scrapers/engine.py"]


# === Stage 3: Production ===
FROM python:3.13-slim AS production

WORKDIR /app

#  OPTIMIZED: Optimized performance flags
ENV PYTHON_JIT=all
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONOPTIMIZE=2

# Create a non-root user for security
RUN groupadd -r bsopt && useradd -r -g bsopt -m -d /home/bsopt bsopt \
    && apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    tini \
    # Playwright deps
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libasound2 \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R bsopt:bsopt /app

# Copy the installed packages from the builder stage
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Install Playwright browsers natively in production stage
RUN playwright install --with-deps chromium

COPY src/ ./src
RUN chown -R bsopt:bsopt /app

USER bsopt

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "src/scrapers/engine.py"]
