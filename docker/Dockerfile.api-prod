# Production Dockerfile for the BS-Opt API Service
# Stage 1: Build dependencies
FROM docker.io/library/python:3.12-slim-bookworm AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
RUN pip install --no-cache-dir uv
ENV UV_HTTP_TIMEOUT=300
ENV UV_RETRIES=10

# Copy requirements and install (API-only deps for lean image)
COPY requirements-api.txt .
RUN uv pip install --no-cache --system -r requirements-api.txt && \
    uv pip install --no-cache --system granian

# Stage 2: Runtime image
FROM docker.io/library/python:3.12-slim-bookworm

WORKDIR /app

# Install runtime dependencies ONLY
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user for security
RUN groupadd -r bsopt && useradd -r -g bsopt bsopt

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy source code
COPY src/ ./src
COPY pyproject.toml .

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    INSIDE_DOCKER=1 \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317 \
    OTEL_SERVICE_NAME=bsopt-api

# Set permissions
RUN chown -R bsopt:bsopt /app

# Switch to non-root user
USER bsopt

EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Granian: High-performance Rust-based HTTP server
CMD ["granian", "--interface", "asgi", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "auto", "--websockets", "--threading_mode", "runtime", "--opt"]
