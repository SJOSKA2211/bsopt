# Unified Docker Environment Variables (High-Performance Optimized)
POSTGRES_DB=bsopt
POSTGRES_USER=admin
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database Connections
# Use port 6432 for PGBouncer (Transactional Pooling)
DATABASE_URL="postgresql://admin:password@pgbouncer:6432/bsopt"
DATABASE_URL_TEST="postgresql://admin:password@postgres:5432/bsopt_test"
DATABASE_URL_LOCAL="postgresql://admin:password@localhost:5434/bsopt"

# Performance Tuning
PGBOUNCER_ENABLED=true
DATABASE_MIN_POOL_SIZE=20
DATABASE_MAX_POOL_SIZE=100
SLOW_QUERY_THRESHOLD_MS=100

# Redis & Broker
REDIS_URL=redis://:bsopt_redis_secret@redis:6379/0
RABBITMQ_USER=admin
RABBITMQ_HOST=rabbitmq
RABBITMQ_URL=amqp://admin:password@rabbitmq:5672//

# Auth & Services
BETTER_AUTH_URL=http://localhost:3001
JWT_ALGORITHM=RS256

# OAuth (Newly Integrated)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

JWT_RS256_PRIVATE=""
