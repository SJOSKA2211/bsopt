# Production Dockerfile for the BS-Opt Worker Service
# Stage 1: Build dependencies
FROM docker.io/library/python:3.12-slim-bookworm AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
RUN pip install --no-cache-dir uv
ENV UV_HTTP_TIMEOUT=300
ENV UV_RETRIES=10

# Copy requirements and install
COPY requirements.txt .
RUN uv pip install --system --no-cache -r requirements.txt

# Stage 2: Runtime image
FROM docker.io/library/python:3.12-slim-bookworm

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user
RUN groupadd -r bsopt && useradd -r -g bsopt bsopt

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy source code
COPY src /app/src
COPY pyproject.toml .

# Environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    INSIDE_DOCKER=1

# Set permissions
RUN chown -R bsopt:bsopt /app

# Switch to non-root user
USER bsopt

# Celery Weaponized: Using thread pool for I/O bound tasks
CMD ["celery", "-A", "src.workers.tasks.celery_app", "worker", "-l", "info", "--pool=threads", "--concurrency=20", "--prefetch-multiplier=1"]
