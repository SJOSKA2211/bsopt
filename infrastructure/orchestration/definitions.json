{
  "rabbit_version": "3.13.7",
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "users": [
    {
      "name": "bsopt_admin",
      "password_hash": "ZpSRv/vCcPhZImPhvGrEvvYAtvAnvQ==",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": [
        "administrator"
      ]
    }
  ],
  "permissions": [
    {
      "user": "bsopt_admin",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "market_data",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "audit_exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "telemetry_exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "market_ticks",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "market_ticks_dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "audit_logs",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "telemetry_logs",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "dead_letter_queue",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "dlx",
      "vhost": "/",
      "destination": "market_ticks_dlq",
      "destination_type": "queue",
      "routing_key": "market_ticks_dlq",
      "arguments": {}
    },
    {
      "source": "dlx",
      "vhost": "/",
      "destination": "dead_letter_queue",
      "destination_type": "queue",
      "routing_key": "dead_letter",
      "arguments": {}
    }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "ha-all",
      "pattern": ".*",
      "apply-to": "all",
      "definition": {
        "ha-mode": "all",
        "ha-sync-mode": "automatic"
      },
      "priority": 0
    },
    {
      "vhost": "/",
      "name": "lazy-queues",
      "pattern": "^.*_logs$|dlq$|dead_letter_queue$",
      "apply-to": "queues",
      "definition": {
        "queue-mode": "lazy"
      },
      "priority": 10
    },
    {
      "vhost": "/",
      "name": "dlq-ttl",
      "pattern": "dlq$|dead_letter_queue$",
      "apply-to": "queues",
      "definition": {
        "message-ttl": 86400000
      },
      "priority": 20
    },
    {
      "vhost": "/",
      "name": "dlx-policy",
      "pattern": "^market_ticks$",
      "apply-to": "queues",
      "definition": {
        "dead-letter-exchange": "dlx",
        "dead-letter-routing-key": "market_ticks_dlq"
      },
      "priority": 30
    }
  ]
}
