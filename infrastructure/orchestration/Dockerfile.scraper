# ==============================================================================
# Manifold: SCRAPER MANIFOLD (v11.1)
# ==============================================================================
# Playwright-backed market data ingestion for the BSOPT platform.
# Rebased on Production Base.
# ==============================================================================

# --- BUILDER ---
FROM Manifold-base:builder AS builder
WORKDIR /app

# Install scraper-specific dependencies
COPY infrastructure/requirements/requirements-scraper.txt /tmp/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r /tmp/requirements-scraper.txt && \
    uv pip install playwright

COPY . .
RUN uv pip install .

# --- DEVELOPMENT ---
FROM Manifold-base:builder AS development
WORKDIR /app

# Install Playwright system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Copy source
COPY . .
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

# Install App + Playwright
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r infrastructure/requirements/requirements-scraper.txt && \
    uv pip install playwright && \
    uv pip install -e .

# Install Playwright browsers
RUN playwright install --with-deps chromium

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["/usr/local/bin/entrypoint-shim.sh"]
CMD ["python", "src/ingestion/engine.py"]

# --- FINAL RUNTIME ---
FROM Manifold-base:final AS production
WORKDIR /app

# Copy the pre-built virtual environment from the scraper builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Playwright system dependencies in runtime
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright browsers
RUN playwright install chromium
RUN chown -R Manifold:Manifold /opt/venv

# Production Security & Performance
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

USER Manifold

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["python", "src/ingestion/engine.py"]
