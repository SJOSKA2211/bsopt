# ==============================================================================
# Manifold: SCRAPER SERVICE (v12.0) - SELF-CONTAINED OPTIMIZED
# ==============================================================================

# --- STAGE 1: BASE BUILDER ---
FROM docker.io/library/python:3.12-slim-bookworm AS base-builder
ENV UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=1000 \
    UV_CACHE_DIR=/root/.cache/uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev gcc git curl && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /usr/local/bin/uv
ENV VIRTUAL_ENV=/opt/venv
RUN uv venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
COPY infrastructure/requirements/requirements-core.txt \
     infrastructure/requirements/requirements-db.txt \
     infrastructure/requirements/requirements-observability.txt /tmp/
RUN uv pip install --no-cache-dir -r /tmp/requirements-core.txt -r /tmp/requirements-db.txt -r /tmp/requirements-observability.txt

# --- STAGE 2: SCRAPER BUILDER ---
FROM base-builder AS scraper-builder
WORKDIR /app
COPY infrastructure/requirements/requirements-scraper.txt /tmp/
RUN uv pip install --no-cache-dir -r /tmp/requirements-scraper.txt
COPY . .
RUN uv pip install --no-cache-dir .

# --- STAGE 3: PRODUCTION RUNTIME ---
FROM docker.io/library/python:3.12-slim-bookworm AS production
ENV PYTHON_JIT=all \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONOPTIMIZE=2 \
    PATH="/opt/venv/bin:$PATH"
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl tini openssl ca-certificates libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 1001 Manifold && useradd -r -u 1001 -g Manifold -m -d /home/Manifold Manifold
WORKDIR /app
COPY --from=scraper-builder /opt/venv /opt/venv
COPY --from=scraper-builder /app /app
RUN playwright install chromium
RUN chown -R Manifold:Manifold /app /opt/venv
USER Manifold
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python3 -c "import time, os; t=float(open('/tmp/scraper_heartbeat').read()); exit(0 if time.time()-t < 60 else 1)"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "src/ingestion/engine.py"]
