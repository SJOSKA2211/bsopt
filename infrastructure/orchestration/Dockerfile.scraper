# ==============================================================================
# Manifold: SCRAPER SERVICE (v12.0) - HARDENED & OPTIMIZED
# ==============================================================================

# Use the pre-built manifold-base stage or image
FROM manifold-base:latest AS builder

USER root
WORKDIR /app

# Install project-specific dependencies
COPY infrastructure/requirements/requirements-scraper.txt ./
RUN uv pip install --no-cache-dir -r requirements-scraper.txt

# Copy source and install project in editable mode for the venv
COPY . .
RUN uv pip install --no-cache-dir .

# --- STAGE 2: PRODUCTION RUNTIME ---
FROM manifold-base:latest AS production

WORKDIR /app

# Copy the pre-built virtual environment and source from builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# Hardening: Final check on permissions
USER Manifold

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import time, os; t=float(open('/tmp/scraper_heartbeat').read()); exit(0 if time.time()-t < 120 else 1)"

# Start the Scraper service
CMD ["python", "-m", "src.ingestion.scraper"]
