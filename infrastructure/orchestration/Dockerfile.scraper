# ==============================================================================
# EQUAFLOW: SCRAPER MANIFOLD (v11.1)
# ==============================================================================
# Playwright-backed market data ingestion for the BSOPT platform.
# Rebased on Institutional Base.
# ==============================================================================

# --- BUILDER ---
FROM equaflow-base:latest AS builder
WORKDIR /app

# Install scraper-specific dependencies
COPY infrastructure/requirements/requirements-scraper.txt /tmp/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r /tmp/requirements-scraper.txt && \
    uv pip install --system playwright

COPY . .
RUN uv pip install --system .

# --- FINAL RUNTIME ---
FROM equaflow-base:latest AS production
WORKDIR /app

# Install Playwright system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Install Playwright browsers (Note: these are large, so they stay in runtime)
RUN /opt/venv/bin/python -m playwright install --with-deps chromium

# Institutional Security & Performance
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

USER equaflow

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["python", "src/ingestion/scrapers/engine.py"]
