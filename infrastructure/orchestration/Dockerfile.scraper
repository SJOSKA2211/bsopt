# ==============================================================================
# EQUAFLOW: SCRAPER MANIFOLD (v11.1)
# ==============================================================================
# Playwright-backed market data ingestion for the BSOPT platform.
# Rebased on Institutional Base.
# ==============================================================================

# --- BUILDER ---
FROM equaflow-base:latest AS builder
WORKDIR /app

COPY pyproject.toml README.md ./
COPY infrastructure/requirements/ /app/infrastructure/requirements/
COPY src ./src

# Install Playwright + App
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r infrastructure/requirements/requirements-core.txt && \
    uv pip install --system -r infrastructure/requirements/requirements-scraper.txt && \
    uv pip install --system -r infrastructure/requirements/requirements-observability.txt && \
    uv pip install --system playwright && \
    uv pip install --system .

# --- DEVELOPMENT ---
FROM equaflow-base:latest AS development
WORKDIR /app

# Install Playwright system dependencies (This stays in dev/production because it's runtime)

# Install Playwright browsers
RUN playwright install --with-deps chromium

# Copy everything for dev (hot-reloading via volumes)
COPY . .
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["python", "src/ingestion/scrapers/engine.py"]

# --- PRODUCTION ---
FROM equaflow-base:latest AS production
WORKDIR /app

# Install Playwright system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
    libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
    libgbm1 libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Copy source + entrypoint
COPY src ./src
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

# Institutional Security & Performance
USER equaflow

HEALTHCHECK --interval=60s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["python", "src/ingestion/scrapers/engine.py"]
