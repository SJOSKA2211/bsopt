# ==============================================================================
# Manifold: RUST CORE BUILDER (v11.1)
# ==============================================================================
# Specialized high-performance math kernel builder.
# ==============================================================================

FROM docker.io/library/python:3.12-slim-bookworm AS builder
WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install Production UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV PATH="/uv/bin:$PATH"

RUN /usr/local/bin/uv pip install --no-cache-dir --system maturin --break-system-packages
RUN rustup component add rustfmt clippy

# Copy source
COPY src/math_kernel/rust-core ./src/math_kernel/rust-core
COPY pyproject.toml .

# Development stage: keep source for testing
FROM builder AS development
CMD ["cargo", "test", "--manifest-path", "src/math_kernel/rust-core/Cargo.toml"]
