# ==============================================================================
# Manifold: RUST CORE BUILDER (v12.0) - ALPINE OPTIMIZED
# ==============================================================================
# Specialized high-performance math kernel builder using Alpine.
# ==============================================================================

FROM docker.io/library/python:3.12-alpine AS builder
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache build-base libpq-dev linux-headers git curl rust cargo openssl-dev

# Build optimization for PyO3/Rust
ENV PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1 \
    RUSTFLAGS="-C target-feature=-crt-static"

# Install Production UV
COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /usr/local/bin/uv

# Install maturin for build
RUN uv pip install --retries 10 --no-cache-dir --system maturin

# Copy source
COPY src/math_kernel/rust-core ./src/math_kernel/rust-core
COPY pyproject.toml .

# Development stage: keep source for testing
FROM builder AS development
# Alpine uses different UID management, Manifold user is 1001
RUN adduser -D -u 1001 Manifold
USER Manifold
CMD ["cargo", "test", "--manifest-path", "src/math_kernel/rust-core/Cargo.toml"]
