FROM docker.io/library/rust:1.75-slim-bookworm as builder

WORKDIR /app
COPY . .

# Install dependencies for PyO3 and Maturin
RUN apt-get update && apt-get install -y \
    python3-dev \
    python3-pip \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/cache/*

RUN pip3 install maturin --break-system-packages
RUN rustup component add rustfmt clippy

# Development stage: keep source for testing
FROM builder as development
CMD ["cargo", "test"]
