# ==============================================================================
# Auth Service — Multi-stage Dockerfile
# ==============================================================================

# --- Stage 1: Builder (compile TypeScript) ---
FROM docker.io/library/node:20-alpine AS builder

WORKDIR /app

COPY src/auth/package*.json ./
RUN apk add --no-cache python3 make g++ && npm install

COPY src/auth ./
RUN npm run build

# --- Stage 2: Development ---
FROM docker.io/library/node:20-alpine AS development

WORKDIR /app

COPY services/auth/package*.json ./
RUN apk add --no-cache python3 make g++ \
    && npm install --prefer-offline --no-audit --progress=false

COPY services/auth .

EXPOSE 3001

CMD ["npm", "run", "dev"]

# --- Stage 3: Production ---
FROM docker.io/library/node:20-alpine AS production

WORKDIR /app

RUN addgroup -S bsopt && adduser -S bsopt -G bsopt

COPY --from=builder /app/package*.json ./
RUN apk add --no-cache python3 make g++ \
    && npm install --omit=dev \
    && apk del python3 make g++

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src ./src

RUN chown -R bsopt:bsopt /app
USER bsopt

EXPOSE 3001

ENV NODE_ENV=production

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:3001/health || exit 1

CMD ["node", "dist/index.js"]

