# ==============================================================================
# Manifold: AUTH SERVICE (v11.1)
# ==============================================================================
# High-performance gRPC authentication gateway.
# Rebased on Production Base.
# ==============================================================================

# --- BUILDER ---
FROM Manifold-base:builder AS builder
WORKDIR /app

# Install App + Dependencies
COPY infrastructure/requirements/requirements-auth.txt /tmp/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r /tmp/requirements-auth.txt

COPY . .
RUN uv pip install .

# --- DEVELOPMENT ---
FROM Manifold-base:builder AS development
WORKDIR /app

# Copy source
COPY . .
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

# Install App
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r infrastructure/requirements/requirements-auth.txt && \
    uv pip install -e .

# --- PRODUCTION ---
FROM Manifold-base:final AS production
WORKDIR /app

# Copy the pre-built virtual environment from the auth builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Production Security & Performance
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

USER Manifold
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:3001/health').read()" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["python", "-m", "src.auth.auth_server"]
