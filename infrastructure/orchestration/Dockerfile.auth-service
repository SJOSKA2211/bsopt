# ==============================================================================
# EQUAFLOW: AUTH SERVICE (v11.1)
# ==============================================================================
# High-performance gRPC authentication gateway.
# Rebased on Institutional Base.
# ==============================================================================

# --- BUILDER ---
FROM equaflow-base:latest AS builder
WORKDIR /app

COPY pyproject.toml requirements.txt README.md ./
COPY src ./src

# Install App + Dependencies into venv
RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r requirements.txt && \
    uv pip install .

# --- DEVELOPMENT ---
FROM equaflow-base:latest AS development
WORKDIR /app

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy source
COPY . .
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 3001
ENTRYPOINT ["/usr/local/bin/entrypoint-shim.sh"]
CMD ["python", "-m", "src.auth.auth_server"]

# --- PRODUCTION ---
FROM equaflow-base:latest AS production
WORKDIR /app

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy source + entrypoint
COPY src ./src
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

# Institutional Security & Performance
USER equaflow
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:3001/health').read()" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["python", "-m", "src.auth.auth_server"]
