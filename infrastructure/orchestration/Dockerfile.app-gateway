# === App Gateway (Apollo Federation) - Fixed for src layout ===

FROM docker.io/library/node:20-alpine AS builder

WORKDIR /app

COPY src/gateway/package*.json ./
RUN npm install --legacy-peer-deps

COPY src/gateway/ ./

FROM docker.io/library/node:20-alpine AS development

WORKDIR /app

COPY src/gateway/package*.json ./
RUN npm install --legacy-peer-deps --prefer-offline --no-audit --progress=false

COPY src/gateway .

EXPOSE 4000

CMD ["node", "index.js"]
