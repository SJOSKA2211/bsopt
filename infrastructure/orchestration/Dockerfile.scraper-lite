# === Stage 1: Builder ===
FROM docker.io/library/python:3.12-slim-bookworm AS builder
RUN pip install uv

WORKDIR /app

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=0
ENV UV_HTTP_TIMEOUT=300
ENV UV_RETRIES=10

RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY pyproject.toml README.md ./
COPY src /app/src

# Install Python dependencies only in builder (no playwright)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install .


# === Stage 2: Development ===
FROM docker.io/library/python:3.12-slim-bookworm AS development

WORKDIR /app

# Install build dependencies for dev (no playwright deps)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy everything for dev (hot-reloading)
COPY . .

ENV PYTHONDONTWRITEBYTECODE=1
CMD ["python", "src/scrapers/engine.py"]


# === Stage 3: Production ===
FROM docker.io/library/python:3.12-slim-bookworm AS production

WORKDIR /app

# OPTIMIZED: Optimized performance flags
ENV PYTHON_JIT=all
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONOPTIMIZE=2

# Create a non-root user for security
RUN groupadd -g 1000 appgroup && \
    useradd -r -u 1000 -g appgroup appuser && \
    apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R appuser:appgroup /app

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY src /app/src
RUN chown -R appuser:appgroup /app

USER appuser

# Native Healthcheck
HEALTHCHECK --interval=60s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import time; import sys; sys.exit(0 if time.time() - float(open('/tmp/scraper_heartbeat').read().strip()) < 300 else 1)" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "src/scrapers/engine.py"]
