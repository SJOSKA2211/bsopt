# ==============================================================================
# Manifold: FRONTEND SERVICE (v12.0) - NGINX OPTIMIZED
# ==============================================================================

# --- STAGE 1: BUILDER ---
FROM docker.io/library/node:22-alpine AS builder
WORKDIR /app

# Configure NPM network resilience
ENV CI=true
RUN npm config set fetch-retries 5 && npm config set fetch-retry-mintimeout 20000 && npm config set fetch-retry-maxtimeout 120000

# Install dependencies
COPY src/frontend/package*.json ./
RUN npm install --no-audit --prefer-offline

# Copy source and build
COPY src/frontend/ .
RUN npm run build

# --- STAGE 2: PRODUCTION RUNTIME ---
FROM docker.io/library/nginx:alpine AS production

# Security: Dedicated Nginx User
RUN addgroup -S nginx_user && adduser -S nginx_user -G nginx_user

# Copy custom nginx config
COPY infrastructure/orchestration/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infrastructure/orchestration/nginx/conf.d /etc/nginx/conf.d

# Copy static files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Hardening: Permissions
RUN touch /var/run/nginx.pid && \
    chown -R nginx_user:nginx_user /var/cache/nginx /var/run/nginx.pid /usr/share/nginx/html

USER nginx_user
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
