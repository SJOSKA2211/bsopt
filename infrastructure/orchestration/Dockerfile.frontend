# ==============================================================================
# Frontend (Vite + React + TypeScript) — Multi-stage Dockerfile
# ==============================================================================

# --- Stage 1: Builder (compile assets) ---
FROM docker.io/library/node:20-alpine AS builder

WORKDIR /app

COPY src/frontend/package*.json ./
RUN npm install

COPY src/frontend ./
RUN npm run build

# --- Stage 2: Development ---
FROM docker.io/library/node:20-alpine AS development

WORKDIR /app

COPY src/frontend/package*.json ./
RUN npm install

COPY src/frontend .

EXPOSE 5173

CMD ["npx", "vite", "--host", "0.0.0.0"]

# --- Stage 3: Production ---
FROM docker.io/library/nginx:alpine AS production

# Copy custom nginx configuration
COPY infra/orchestration/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infra/orchestration/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf

# Copy the built assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port 80
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
