# ==============================================================================
# Manifold: FRONTEND SERVICE (v12.0)
# ==============================================================================
# React/Vite/TypeScript frontend optimized for production Nginx (Alpine).
# ==============================================================================

# --- STAGE 1: BUILDER ---
FROM docker.io/library/node:20-alpine AS builder
WORKDIR /app

# Install dependencies
COPY src/frontend/package*.json ./
RUN npm ci

# Copy source and build
COPY src/frontend/ .
RUN npm run build

# --- STAGE 2: PRODUCTION RUNTIME ---
FROM docker.io/library/nginx:alpine AS production

# Copy custom nginx configuration
COPY infrastructure/orchestration/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infrastructure/orchestration/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf

# Copy build artifacts
COPY --from=builder /app/dist /usr/share/nginx/html

# Security: Non-root Nginx
RUN chown -R nginx:nginx /var/cache/nginx /var/log/nginx /usr/share/nginx/html /etc/nginx/conf.d

USER nginx
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
