# Development Dockerfile for the Neural Pricing Service
FROM docker.io/library/python:3.12-slim-bookworm

WORKDIR /app

# Install build dependencies for requirements.txt
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install Python dependencies using uv for speed
RUN pip install --no-cache-dir uv
ENV UV_HTTP_TIMEOUT=300
ENV UV_RETRIES=10
ENV UV_TCP_KEEPALIVE=1
COPY requirements-ml-cpu.txt requirements-api.txt ./
RUN uv pip install --system --no-cache --index-strategy unsafe-best-match -r requirements-ml-cpu.txt

# Copy the entire source directory for development
COPY src /app/src
# Copy pyproject.toml for local package references
COPY pyproject.toml .

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "src.quant.pricing.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
