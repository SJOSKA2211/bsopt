# ==============================================================================
# Manifold: HARDENED BASE RUNTIME (v12.0)
# ==============================================================================
# Ultra-lean, high-performance foundation powered by Astral UV.
# Optimized for distroless production and multi-stage builds.
# ==============================================================================

# --- STAGE 1: BUILDER ---
FROM docker.io/library/python:3.12-slim-bookworm AS builder

# Build Settings
ENV UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=1000 \
    UV_CACHE_DIR=/root/.cache/uv \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System Build Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install UV
COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /usr/local/bin/uv
ENV PATH="/uv/bin:$PATH"

# Create Virtual Environment
ENV VIRTUAL_ENV=/opt/venv
RUN uv venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Pre-install Common Dependencies
WORKDIR /tmp
COPY infrastructure/requirements/requirements-core.txt \
     infrastructure/requirements/requirements-db.txt \
     infrastructure/requirements/requirements-observability.txt ./

RUN uv pip install --no-cache-dir \
    -r requirements-core.txt \
    -r requirements-db.txt \
    -r requirements-observability.txt

# --- STAGE 2: PRODUCTION RUNTIME ---
FROM docker.io/library/python:3.12-slim-bookworm AS runtime

# Production Environment Settings
ENV PYTHON_JIT=all \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONOPTIMIZE=2 \
    PATH="/opt/venv/bin:$PATH"

# Runtime System Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    tini \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Hardening: Dedicated Non-Root User
RUN groupadd -g 1001 Manifold && \
    useradd -r -u 1001 -g Manifold -m -d /home/Manifold Manifold

WORKDIR /app
RUN chown -R Manifold:Manifold /app

# Copy the pre-built virtual environment
COPY --from=builder /opt/venv /opt/venv
# Copy uv to allow child images to use it for further specific installs
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv

USER Manifold

# Final image serves as the foundation for all other Python services.
