# BASE RUNTIME
# High-performance foundation for all microservices.
# Powered by Astral UV.

# --- RUNTIME BASE ---
FROM docker.io/library/python:3.12-slim-bookworm AS runtime

# Environment
ENV PYTHON_JIT=all \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONOPTIMIZE=2 \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=300 \
    PATH="/opt/venv/bin:$PATH"

# System Dependencies & Hardening
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    tini \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Security: Dedicated Non-Root User
RUN groupadd -g 1000 Manifold && \
    useradd -r -u 1000 -g Manifold -m -d /home/Manifold Manifold

WORKDIR /app
RUN chown -R Manifold:Manifold /app

# --- BUILDER FOUNDATION ---
FROM runtime AS builder

# Build-time dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install UV
COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /usr/local/bin/uv
ENV PATH="/uv/bin:$PATH"

# UV Cache Settings
ENV UV_CACHE_DIR=/root/.cache/uv \
    UV_HTTP_TIMEOUT=300 \
    UV_LINK_MODE=copy

# Create a virtual environment for all services
RUN uv venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Pre-install Core Dependencies (Shared across all services)
COPY infrastructure/requirements/requirements-core.txt /tmp/
COPY infrastructure/requirements/requirements-db.txt /tmp/
COPY infrastructure/requirements/requirements-observability.txt /tmp/

RUN /usr/local/bin/uv pip install --no-cache-dir \
    -r /tmp/requirements-core.txt \
    -r /tmp/requirements-db.txt \
    -r /tmp/requirements-observability.txt

# --- FINAL PRODUCTION BASE ---
FROM runtime AS final

# Copy uv from builder to make it available for child images
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv

# Copy the pre-built virtual environment
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Ensure the app directory exists and is owned by Manifold
WORKDIR /app
RUN chown -R Manifold:Manifold /app

USER Manifold
