# ==============================================================================
# EQUAFLOW: THE INSTITUTIONAL-GRADE BASE (v1.0)
# ==============================================================================
# High-performance, secure, and lean foundation for all EquaFlow microservices.
# Powered by Astral UV.
# ==============================================================================

# --- RUNTIME BASE ---
FROM docker.io/library/python:3.12-slim-bookworm AS runtime

# Institutional Environment
ENV PYTHON_JIT=all \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONOPTIMIZE=2 \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH"

# System Dependencies & Hardening
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    tini \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Security: Dedicated Non-Root User
RUN groupadd -g 1000 equaflow && \
    useradd -r -u 1000 -g equaflow -m -d /home/equaflow equaflow

WORKDIR /app
RUN chown -R equaflow:equaflow /app

# --- BUILDER FOUNDATION ---
FROM runtime AS builder

# Build-time dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    gcc \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install UV
COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /uv/bin/uv
ENV PATH="/uv/bin:$PATH"

# Persistent UV Cache & Institutional Settings
ENV UV_CACHE_DIR=/root/.cache/uv \
    UV_HTTP_TIMEOUT=300 \
    UV_LINK_MODE=copy

# Pre-install Core Dependencies (Shared across all services)
COPY infrastructure/requirements/requirements-core.txt /tmp/
COPY infrastructure/requirements/requirements-db.txt /tmp/
COPY infrastructure/requirements/requirements-observability.txt /tmp/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system \
    -r /tmp/requirements-core.txt \
    -r /tmp/requirements-db.txt \
    -r /tmp/requirements-observability.txt
