# ==============================================================================
# Manifold: HARDENED BASE RUNTIME (v12.0)
# ==============================================================================
# Ultra-lean, high-performance foundation powered by Alpine & Astral UV.
# Optimized for minimal production footprint and multi-stage builds.
# ==============================================================================

# --- STAGE 1: BUILDER ---
FROM docker.io/library/python:3.12-alpine AS builder

# Build Settings
ENV UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=30000 \
    UV_CONCURRENT_DOWNLOADS=2 \
    UV_RETRIES=10 \
    UV_CACHE_DIR=/root/.cache/uv \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# System Build Dependencies for Alpine (musl compatible)
RUN apk add --no-cache \
    build-base \
    postgresql-dev \
    linux-headers \
    git \
    curl \
    rust \
    cargo \
    openssl-dev \
    libffi-dev

# Build optimization for PyO3/Rust (Critical for Alpine/musl)
ENV PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1 \
    RUSTFLAGS="-C target-feature=-crt-static"

# Install UV
COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /usr/local/bin/uv

# Create Virtual Environment
ENV VIRTUAL_ENV=/opt/venv
RUN uv venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Pre-install Common Dependencies
WORKDIR /tmp
COPY infrastructure/requirements/requirements-core.txt \
     infrastructure/requirements/requirements-db.txt \
     infrastructure/requirements/requirements-observability.txt ./

RUN uv pip install --no-cache-dir \
    -r requirements-core.txt \
    -r requirements-db.txt \
    -r requirements-observability.txt

# --- STAGE 2: PRODUCTION RUNTIME ---
FROM docker.io/library/python:3.12-alpine AS production

# Production Environment Settings
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONOPTIMIZE=2 \
    PATH="/opt/venv/bin:$PATH" \
    ENVIRONMENT=production

# Runtime System Dependencies (Minimal Alpine)
# Only libpq for DB and tini for signal handling
RUN apk add --no-cache \
    libpq \
    tini \
    ca-certificates \
    tzdata \
    curl

# Install gRPC Health Probe
RUN GRPC_HEALTH_PROBE_VERSION=v0.4.24 && \
    curl -Lo /usr/local/bin/grpc_health_probe https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe-linux-amd64 && \
    chmod +x /usr/local/bin/grpc_health_probe

# Hardening: Dedicated Non-Root User
RUN addgroup -g 1001 Manifold && \
    adduser -D -u 1001 -G Manifold -h /home/Manifold Manifold

WORKDIR /app

# Copy the pre-built virtual environment
COPY --from=builder /opt/venv /opt/venv
# Note: We do NOT copy UV to production runtime for maximum hardening.
# If child images need UV, they should use the builder stage.

RUN chown -R Manifold:Manifold /app /opt/venv

USER Manifold

# Final image serves as the foundation for all other Python services.
ENTRYPOINT ["/usr/bin/tini", "--"]
