# ==============================================================================
# EQUAFLOW: MLOPS MANIFOLD (v11.1)
# ==============================================================================
# GPU-optimized ML orchestration powered by Ray and UV.
# ==============================================================================

FROM docker.io/library/rayproject/ray:latest-py312-cpu AS runtime
WORKDIR /app

# Switch to root for system-level hardening
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev gcc curl git tini \
    && rm -rf /var/lib/apt/lists/*

# Install Institutional UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uv/bin/uv
ENV PATH="/uv/bin:$PATH"

COPY pyproject.toml requirements.txt README.md ./

# Optimized Dependency Layer
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install --system -r requirements.txt && \
    uv pip install --system .[ml,distributed]

# Copy Source
COPY src ./src

# Institutional Environment Tuning
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONOPTIMIZE=2 \
    RAY_ADDRESS=auto \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=4 \
    NUMEXPR_NUM_THREADS=4 \
    NUMBA_CACHE_DIR=/tmp/numba_cache

RUN mkdir -p /tmp/numba_cache && chmod 777 /tmp/numba_cache

# Switch back to ray user for runtime
USER ray

# Default to MLflow orchestration
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["mlflow", "run", ".", "--env-manager", "local"]
