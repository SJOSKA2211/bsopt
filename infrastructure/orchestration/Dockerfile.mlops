# ==============================================================================
# Manifold: MLOPS SERVICE (v12.0) - SELF-CONTAINED OPTIMIZED
# ==============================================================================

# --- STAGE 1: BASE BUILDER ---
FROM docker.io/library/python:3.12-slim-bookworm AS base-builder
ENV UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=1000 \
    UV_CACHE_DIR=/root/.cache/uv
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libpq-dev  git curl libssl-dev && rm -rf /var/lib/apt/lists/*
ENV PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1 \
    RUSTFLAGS="-C target-feature=-crt-static"
COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /usr/local/bin/uv
ENV VIRTUAL_ENV=/opt/venv
RUN uv venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
COPY infrastructure/requirements/requirements-core.txt \
     infrastructure/requirements/requirements-db.txt \
     infrastructure/requirements/requirements-observability.txt /tmp/
RUN uv pip install --no-cache-dir -r /tmp/requirements-core.txt -r /tmp/requirements-db.txt -r /tmp/requirements-observability.txt

# --- STAGE 2: MLOPS BUILDER ---
FROM base-builder AS mlops-builder
WORKDIR /app
COPY infrastructure/requirements/requirements-ml.txt /tmp/
RUN uv pip install --no-cache-dir -r /tmp/requirements-ml.txt
COPY . .
RUN uv pip install --no-cache-dir .

# --- STAGE 3: PRODUCTION RUNTIME ---
FROM docker.io/library/python:3.12-slim-bookworm AS production
ENV PYTHON_JIT=all \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONOPTIMIZE=2 \
    PATH="/opt/venv/bin:$PATH"
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 curl tini openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 1001 Manifold && useradd -r -u 1001 -g Manifold -m -d /home/Manifold Manifold
WORKDIR /app
COPY --from=mlops-builder /opt/venv /opt/venv
COPY --from=mlops-builder /app /app
RUN chown -R Manifold:Manifold /app /opt/venv
USER Manifold
HEALTHCHECK --interval=60s --timeout=15s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["mlflow", "run", ".", "--env-manager", "local"]
