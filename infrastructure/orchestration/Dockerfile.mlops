# ==============================================================================
# Manifold: MLOPS MANIFOLD (v11.1)
# ==============================================================================
# GPU-optimized ML orchestration powered by Ray and UV.
# ==============================================================================

FROM docker.io/rayproject/ray:latest-py312-cpu AS runtime
WORKDIR /app

# Switch to root for system-level hardening
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev gcc curl git tini \
    && rm -rf /var/lib/apt/lists/*

# Install Production UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV PATH="/uv/bin:$PATH"

COPY pyproject.toml README.md ./
COPY infrastructure/requirements/ /app/infrastructure/requirements/

# Optimized Dependency Layer
RUN  \
    /usr/local/bin/uv pip install --no-cache-dir --system torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    /usr/local/bin/uv pip install --no-cache-dir --system -r infrastructure/requirements/requirements-core.txt && \
    /usr/local/bin/uv pip install --no-cache-dir --system -r infrastructure/requirements/requirements-ml.txt && \
    /usr/local/bin/uv pip install --no-cache-dir --system -r infrastructure/requirements/requirements-worker.txt && \
    /usr/local/bin/uv pip install --no-cache-dir --system -r infrastructure/requirements/requirements-observability.txt && \
    /usr/local/bin/uv pip install --no-cache-dir --system .

# Copy Source
COPY src ./src

# Production Environment Tuning
ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONOPTIMIZE=2 \
    RAY_ADDRESS=auto \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=4 \
    NUMEXPR_NUM_THREADS=4 \
    NUMBA_CACHE_DIR=/tmp/numba_cache

RUN mkdir -p /tmp/numba_cache && chmod 777 /tmp/numba_cache

# Switch back to ray user for runtime
USER ray

# Default to MLflow orchestration
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["mlflow", "run", ".", "--env-manager", "local"]
