# ==============================================================================
# BSOPT: MLOps Service - OMARCHY ABSOLUTE Hardened (v10.0 - Alpine Multi-Stage)
# ==============================================================================

# --- Stage 1: Build Environment ---
FROM python@sha256:236173eb74001afe2f60862de935b74fcbd00adfca247b2c27051a70a6a39a2d AS builder

WORKDIR /build

# Build dependencies
RUN apk add --no-cache \
    build-base \
    curl \
    git \
    libffi-dev \
    openssl-dev \
    python3-dev

# Install uv 
COPY --from=ghcr.io/astral-sh/uv:0.4 /uv /uvx /bin/

# Copy dependency definitions
COPY pyproject.toml uv.lock ./

# Synchronize dependencies (MLOps specific extras)
RUN uv sync --no-dev --extra ml --extra shared --frozen

# Copy source
COPY src ./src

# --- Stage 2: Final Runtime ---
FROM python@sha256:236173eb74001afe2f60862de935b74fcbd00adfca247b2c27051a70a6a39a2d AS final

WORKDIR /app
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

# Runtime dependencies
RUN apk add --no-cache \
    openssl \
    ca-certificates \
    libstdc++

# Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy artifacts
COPY --from=builder /build/.venv /app/.venv
COPY --from=builder /build/src /app/src

# Security enforcement
RUN chown -R appuser:appgroup /app
USER appuser

CMD ["python", "src/ml/pipeline.py"]
