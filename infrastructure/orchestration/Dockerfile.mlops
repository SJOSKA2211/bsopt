# ==============================================================================
# Manifold: MLOPS SERVICE (v12.0)
# ==============================================================================
# GPU-optimized ML orchestration powered by Ray and UV.
# ==============================================================================

# --- STAGE 1: BUILDER ---
FROM manifold-base:latest AS builder
USER root
WORKDIR /app

# Install ML-specific dependencies
COPY infrastructure/requirements/requirements-ml.txt /tmp/
RUN /usr/local/bin/uv pip install --no-cache-dir \
    -r /tmp/requirements-ml.txt

# Copy source and install
COPY . .
RUN /usr/local/bin/uv pip install --no-cache-dir .

# --- STAGE 2: PRODUCTION ---
FROM manifold-base:latest AS production
USER root
WORKDIR /app

# Copy the pre-built virtual environment
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# ML-specific settings
ENV OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    PYTHONOPTIMIZE=2

RUN chown -R Manifold:Manifold /app /opt/venv

USER Manifold

# Health check using mlflow health endpoint if applicable or internal metrics
HEALTHCHECK --interval=60s --timeout=15s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["mlflow", "run", ".", "--env-manager", "local"]
