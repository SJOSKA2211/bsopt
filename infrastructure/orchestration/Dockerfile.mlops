# ==============================================================================
# Manifold: MLOPS SERVICE (v12.0) - HARDENED & OPTIMIZED
# ==============================================================================

# Use the pre-built manifold-base-builder stage or image
FROM manifold-base:builder AS builder

USER root
WORKDIR /app

# Install project-specific dependencies
COPY infrastructure/requirements/requirements-ml.txt ./
RUN uv pip install --no-cache-dir -r requirements-ml.txt

# Copy source and install project in editable mode for the venv
COPY . .
RUN uv pip install --no-cache-dir .

# --- STAGE 2: PRODUCTION RUNTIME ---
FROM manifold-base:latest AS production

WORKDIR /app

# Copy the pre-built virtual environment and source from builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# Hardening: Final check on permissions
USER Manifold

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Start the MLOps worker/service
CMD ["python", "-m", "src.mlops.worker"]
