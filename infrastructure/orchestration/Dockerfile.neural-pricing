# ==============================================================================
# EQUAFLOW: NEURAL PRICING MANIFOLD (v11.1)
# ==============================================================================
# GPU-optimized quant pricing engine for the BSOPT platform.
# Rebased on Institutional Base.
# ==============================================================================

# --- BUILDER ---
FROM equaflow-base:latest AS builder
WORKDIR /app

# Install build-time specific dependencies (Rust for math kernels)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_BUILD_JOBS=1

COPY pyproject.toml README.md ./
COPY infrastructure/requirements/ /app/infrastructure/requirements/
COPY src ./src

# Build Wheel for Rust Core
RUN uv pip install --system maturin
RUN cd src/math_kernel/rust-core && maturin build --release --strip --out /tmp/wheels

# Install App + Dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install --system -r infrastructure/requirements/requirements-core.txt && \
    uv pip install --system -r infrastructure/requirements/requirements-db.txt && \
    uv pip install --system -r infrastructure/requirements/requirements-ml.txt && \
    uv pip install --system -r infrastructure/requirements/requirements-observability.txt && \
    uv pip install --system . && \
    uv pip install --system /tmp/wheels/*.whl

# --- DEVELOPMENT ---
FROM equaflow-base:latest AS development
WORKDIR /app

# Copy source
COPY . .
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/entrypoint-shim.sh"]
CMD ["python", "-m", "src.quant.pricing.main"]

# --- PRODUCTION ---
FROM equaflow-base:latest AS production
WORKDIR /app

# Copy source + entrypoint
COPY src ./src
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

# Institutional Security & Performance
USER equaflow
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health').read()" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["granian", "--interface", "asgi", "src.quant.pricing.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--loop", "uvloop", "--threads", "1", "--opt", "--ws"]
