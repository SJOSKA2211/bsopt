# ==============================================================================
# Manifold: NEURAL PRICING MANIFOLD (v11.1)
# ==============================================================================
# GPU-optimized quant pricing engine for the BSOPT platform.
# Rebased on Production Base.
# ==============================================================================

# --- BUILDER ---
FROM manifold-base:latest AS builder
USER root
WORKDIR /app

# Install build-time specific dependencies (Rust for math kernels)
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_BUILD_JOBS=1

# Build Wheel for Rust Core
COPY . .
RUN /usr/local/bin/uv pip install --no-cache-dir maturin
RUN cd src/math_kernel/rust-core && maturin build --release --strip --out /tmp/wheels

# Install App + Dependencies
COPY infrastructure/requirements/requirements-ml.txt /tmp/
RUN  \
    /usr/local/bin/uv pip install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    /usr/local/bin/uv pip install --no-cache-dir -r /tmp/requirements-ml.txt && \
    /usr/local/bin/uv pip install --no-cache-dir . && \
    /usr/local/bin/uv pip install --no-cache-dir /tmp/wheels/*.whl

# --- DEVELOPMENT ---
FROM manifold-base:latest AS development
USER root
WORKDIR /app

# Copy source
COPY . .
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

USER Manifold

# Install App in editable mode
RUN  \
    /usr/local/bin/uv pip install --no-cache-dir -r infrastructure/requirements/requirements-ml.txt && \
    /usr/local/bin/uv pip install --no-cache-dir -e .

# --- PRODUCTION ---
FROM manifold-base:latest AS production
USER root
WORKDIR /app

# Copy the pre-built virtual environment from the neural builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Production Security & Performance
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

USER Manifold
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health').read()" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["granian", "--interface", "asgi", "src.quant.pricing.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--loop", "uvloop", "--threads", "1", "--opt", "--ws"]
