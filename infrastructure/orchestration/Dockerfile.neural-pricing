# Manifold: NEURAL PRICING SERVICE (v12.0) - SELF-CONTAINED OPTIMIZED
# ==============================================================================

# --- STAGE 1: BASE BUILDER ---
FROM docker.io/library/python:3.12-slim-bookworm AS base-builder
ENV UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=1000 \
    UV_CACHE_DIR=/root/.cache/uv
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev gcc git curl && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /usr/local/bin/uv
ENV VIRTUAL_ENV=/opt/venv
RUN uv venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
COPY infrastructure/requirements/requirements-core.txt \
     infrastructure/requirements/requirements-db.txt \
     infrastructure/requirements/requirements-observability.txt /tmp/
RUN uv pip install --no-cache-dir -r /tmp/requirements-core.txt -r /tmp/requirements-db.txt -r /tmp/requirements-observability.txt

# --- STAGE 2: PRICING BUILDER ---
FROM base-builder AS pricing-builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl build-essential && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
COPY infrastructure/requirements/requirements-ml.txt /tmp/
RUN uv pip install --no-cache-dir -r /tmp/requirements-ml.txt
COPY . .
RUN uv pip install --no-cache-dir .

# --- STAGE 3: PRODUCTION RUNTIME ---
FROM docker.io/library/python:3.12-slim-bookworm AS production
ENV PYTHON_JIT=all \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONOPTIMIZE=2 \
    PATH="/opt/venv/bin:$PATH"
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl tini openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN groupadd -g 1001 Manifold && useradd -r -u 1001 -g Manifold -m -d /home/Manifold Manifold
WORKDIR /app
COPY --from=pricing-builder /opt/venv /opt/venv
COPY --from=pricing-builder /app /app
RUN chown -R Manifold:Manifold /app /opt/venv
USER Manifold
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health').read()" || exit 1
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["granian", "--interface", "asgi", "src.quant.pricing.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--loop", "uvloop", "--ws"]
