# ==============================================================================
# Manifold: NEURAL PRICING SERVICE (v12.0)
# ==============================================================================
# GPU-optimized pricing engine powered by Rust and ONNX.
# ==============================================================================

# --- STAGE 1: BUILDER ---
FROM manifold-base:latest AS builder
USER root
WORKDIR /app

# Build Settings
ENV UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=1000 \
    UV_CACHE_DIR=/root/.cache/uv

# Install Rust for building math kernels
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install ML requirements
COPY infrastructure/requirements/requirements-ml.txt /tmp/
RUN /usr/local/bin/uv pip install --no-cache-dir \
    -r /tmp/requirements-ml.txt

# Copy source and build
COPY . .
RUN /usr/local/bin/uv pip install --no-cache-dir .

# --- STAGE 2: PRODUCTION ---
FROM manifold-base:latest AS production
USER root
WORKDIR /app

# Finalize image settings
ENV PYTHONOPTIMIZE=2 \
    PYTHONUNBUFFERED=1

# Copy the pre-built virtual environment from the builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# Ensure proper ownership
RUN chown -R Manifold:Manifold /app /opt/venv

USER Manifold
EXPOSE 8000

# Health check using urllib for minimum footprint
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health').read()" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["granian", "--interface", "asgi", "src.quant.pricing.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--loop", "uvloop", "--ws"]
