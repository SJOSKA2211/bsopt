# ==============================================================================
# Manifold: WORKER SERVICE (v12.0) - HARDENED & OPTIMIZED
# ==============================================================================

# Use the pre-built manifold-base-builder stage or image
FROM manifold-base:builder AS builder

USER root
WORKDIR /app

# Install project-specific dependencies
COPY infrastructure/requirements/requirements-worker.txt ./
RUN uv pip install --retries 10 --no-cache-dir -r requirements-worker.txt

# Copy source and install project in editable mode for the venv
COPY . .
RUN uv pip install --retries 10 --no-cache-dir .

# --- STAGE 2: PRODUCTION RUNTIME ---
FROM manifold-base:latest AS production

WORKDIR /app

# Copy the pre-built virtual environment and source from builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# Hardening: Final check on permissions
USER Manifold

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD celery -A src.workers.tasks.celery_app inspect ping || exit 1

# Start the Celery worker
CMD ["celery", "-A", "src.workers.tasks.celery_app", "worker", "--loglevel=info", "--concurrency=4"]
