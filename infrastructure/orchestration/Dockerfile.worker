# ==============================================================================
# Manifold: WORKER MANIFOLD (v11.1)
# ==============================================================================
# Lean, high-performance Celery worker for the BSOPT platform.
# Rebased on Production Base.
# ==============================================================================

# --- BUILDER ---
FROM manifold-base:latest AS builder
USER root
WORKDIR /app

# Install worker-specific dependencies
COPY infrastructure/requirements/requirements-worker.txt /tmp/
RUN  \
    /usr/local/bin/uv pip install --no-cache-dir torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    /usr/local/bin/uv pip install --no-cache-dir -r /tmp/requirements-worker.txt

COPY . .
RUN /usr/local/bin/uv pip install --no-cache-dir .

# --- DEVELOPMENT ---
FROM manifold-base:latest AS development
WORKDIR /app

# Copy source
COPY . .
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

# Install App
RUN  \
    /usr/local/bin/uv pip install --no-cache-dir -r infrastructure/requirements/requirements-worker.txt && \
    /usr/local/bin/uv pip install --no-cache-dir -e .

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["/usr/local/bin/entrypoint-shim.sh"]
CMD ["celery", "-A", "src.workers.tasks.celery_app", "worker", "-l", "info", "--concurrency", "2"]

# --- FINAL RUNTIME ---
FROM manifold-base:latest AS production
WORKDIR /app

# Copy the pre-built virtual environment from the worker builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Production Security & Performance
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

USER Manifold

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["celery", "-A", "src.workers.tasks.celery_app", "worker", "-l", "info", "--concurrency", "4"]
