# ==============================================================================
# EQUAFLOW: WORKER MANIFOLD (v11.1)
# ==============================================================================
# Lean, high-performance Celery worker for the BSOPT platform.
# Rebased on Institutional Base.
# ==============================================================================

# --- BUILDER ---
FROM equaflow-base:builder AS builder
WORKDIR /app

# Install worker-specific dependencies
COPY infrastructure/requirements/requirements-worker.txt /tmp/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install -r /tmp/requirements-worker.txt

COPY . .
RUN uv pip install .

# --- DEVELOPMENT ---
FROM equaflow-base:builder AS development
WORKDIR /app

# Copy source
COPY . .
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

# Install App
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r infrastructure/requirements/requirements-worker.txt && \
    uv pip install -e .

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["/usr/local/bin/entrypoint-shim.sh"]
CMD ["celery", "-A", "src.workers.tasks.celery_app", "worker", "-l", "info", "--concurrency", "2"]

# --- FINAL RUNTIME ---
FROM equaflow-base:final AS production
WORKDIR /app

# Copy the pre-built virtual environment from the worker builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Institutional Security & Performance
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

USER equaflow

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["celery", "-A", "src.workers.tasks.celery_app", "worker", "-l", "info", "--concurrency", "4"]
