# ==============================================================================
# EQUAFLOW: WORKER MANIFOLD (v11.1)
# ==============================================================================
# Lean, high-performance Celery worker for the BSOPT platform.
# Rebased on Institutional Base.
# ==============================================================================

# --- BUILDER ---
FROM equaflow-base:latest AS builder
WORKDIR /app

# Install build-time specific dependencies (Rust for math kernels)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_BUILD_JOBS=1

COPY pyproject.toml requirements.txt ./
COPY src ./src

# Build Wheel for Rust Core
RUN uv pip install --system maturin
RUN cd src/math_kernel/rust-core && maturin build --release --strip --out /tmp/wheels

# Install App + Dependencies into venv
RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# OPTIMIZED: Install ML dependencies only if needed, but here we include standard ones
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install -r requirements.txt && \
    uv pip install .[workers,ml] && \
    uv pip install /tmp/wheels/*.whl

# --- DEVELOPMENT ---
FROM equaflow-base:latest AS development
WORKDIR /app

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy everything for dev (hot-reloading via volumes)
COPY . .
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["/usr/local/bin/entrypoint-shim.sh"]
CMD ["celery", "-A", "src.workers.tasks.celery_app", "worker", "-l", "info"]

# --- PRODUCTION ---
FROM equaflow-base:latest AS production
WORKDIR /app

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy source + entrypoint
COPY src ./src
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

# Institutional Security & Performance
USER equaflow

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["celery", "-A", "src.workers.tasks.celery_app", "worker", "-l", "info", "--concurrency", "4"]
