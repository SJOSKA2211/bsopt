# ==============================================================================
# Manifold: WORKER SERVICE (v12.0)
# ==============================================================================
# High-performance Celery worker with pre-built math kernels.
# ==============================================================================

# --- STAGE 1: BUILDER ---
FROM manifold-base:latest AS builder
USER root
WORKDIR /app

# Build Settings
ENV UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=1000 \
    UV_CACHE_DIR=/root/.cache/uv

# Install Worker-specific requirements
COPY infrastructure/requirements/requirements-worker.txt /tmp/
RUN /usr/local/bin/uv pip install --no-cache-dir \
    -r /tmp/requirements-worker.txt

# Copy source and install the project
COPY . .
RUN /usr/local/bin/uv pip install --no-cache-dir .

# --- STAGE 2: PRODUCTION ---
FROM manifold-base:latest AS production
USER root
WORKDIR /app

# Finalize image settings
ENV PYTHONOPTIMIZE=2 \
    PYTHONUNBUFFERED=1

# Copy the pre-built virtual environment from the builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# Ensure proper ownership
RUN chown -R Manifold:Manifold /app /opt/venv

USER Manifold

# Health check using celery's native inspect ping
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD celery -A src.workers.tasks.celery_app inspect ping || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["celery", "-A", "src.workers.tasks.celery_app", "worker", "-l", "info", "--concurrency", "4"]
