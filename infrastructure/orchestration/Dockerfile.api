# ==============================================================================
# BSOPT: API Service - Production Hardened (v9.2 - Slim)
# ==============================================================================

# --- Stage 1: Rust Builder ---
FROM python:3.12.13-slim AS rust-builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libssl-dev \
    pkg-config \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:$PATH"

COPY src/math_kernel/rust-core ./rust-core
RUN pip install --no-cache-dir maturin
RUN cd rust-core && maturin build --release --out /build/wheels

# --- Stage 2: Python Builder ---
FROM python:3.12.13-slim AS builder
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Create virtualenv
RUN uv venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY pyproject.toml .
RUN uv pip install --no-cache-dir .[api,shared] grpcio-tools

COPY --from=rust-builder /build/wheels/*.whl /tmp/
RUN uv pip install --no-cache-dir /tmp/*.whl && rm /tmp/*.whl

COPY src ./src
COPY protos ./protos
RUN python -m grpc_tools.protoc -I./protos --python_out=./src/shared/protos --grpc_python_out=./src/shared/protos ./protos/*.proto && \
    sed -i 's/^import \([^ ]*\)_pb2/from . import \1_pb2/g' ./src/shared/protos/*_pb2*.py

# --- Stage 3: Final Runtime ---
FROM python:3.12.13-slim
WORKDIR /app
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    curl \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/src /app/src
COPY api /app/api

RUN groupadd -r appgroup && useradd -r -g appgroup appuser
RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 8000
CMD ["uvicorn", "api.index:app", "--host", "0.0.0.0", "--port", "8000"]
