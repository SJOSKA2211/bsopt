# ==============================================================================
# BSOPT: API Service - OMARCHY ABSOLUTE Hardened (v10.0 - Alpine Multi-Stage)
# ==============================================================================

# --- Stage 1: Build Environment ---
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libffi-dev \
    libssl-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install uv 
COPY --from=ghcr.io/astral-sh/uv:0.4 /uv /uvx /bin/

# Copy dependency definitions
COPY pyproject.toml uv.lock ./

# Synchronize dependencies (API specific extras)
RUN uv sync --no-dev --extra api --extra shared --extra observability --frozen

# Copy source and protos
COPY src ./src
COPY protos ./protos

# Generate gRPC manifests
RUN .venv/bin/python -m grpc_tools.protoc -I./protos \
    --python_out=./src/shared/protos \
    --grpc_python_out=./src/shared/protos \
    protos/*.proto && \
    sed -i 's/^import \([^ ]*\)_pb2/from . import \1_pb2/g' ./src/shared/protos/*_pb2*.py

# --- Stage 2: Final Runtime ---
FROM python:3.12-slim-bookworm AS final

WORKDIR /app
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    libstdc++6 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

# Copy build artifacts
COPY --from=builder /build/.venv /app/.venv
COPY --from=builder /build/src /app/src

# Security enforcement
RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.api.index:app", "--host", "0.0.0.0", "--port", "8000"]
