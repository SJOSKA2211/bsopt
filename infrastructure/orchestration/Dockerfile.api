# ==============================================================================
# Manifold: API SERVICE (v12.0)
# ==============================================================================
# High-performance ASGI gateway powered by Granian and UV.
# ==============================================================================

# --- STAGE 1: BUILDER ---
FROM manifold-base:latest AS builder
USER root
WORKDIR /app

# Build Settings
ENV UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=1000 \
    UV_CACHE_DIR=/root/.cache/uv

# Install API-specific requirements
COPY infrastructure/requirements/requirements-api.txt /tmp/
RUN /usr/local/bin/uv pip install --no-cache-dir \
    -r /tmp/requirements-api.txt

# Copy source and install the project
COPY . .
RUN /usr/local/bin/uv pip install --no-cache-dir .

# --- STAGE 2: PRODUCTION ---
FROM manifold-base:latest AS production
USER root
WORKDIR /app

# Finalize image settings
ENV PYTHONOPTIMIZE=2 \
    PYTHONUNBUFFERED=1

# Copy the pre-built virtual environment from the builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# Ensure proper ownership
RUN chown -R Manifold:Manifold /app /opt/venv

USER Manifold
EXPOSE 8000

# Health check using urllib for minimum footprint
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health').read()" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["granian", "--interface", "asgi", "api.index:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--loop", "uvloop", "--ws"]
