# ==============================================================================
# Manifold: API SERVICE (v12.0) - SELF-CONTAINED OPTIMIZED
# ==============================================================================

# --- STAGE 1: BASE BUILDER ---
FROM docker.io/library/python:3.12-alpine AS base-builder
ENV UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=1000 \
    UV_CACHE_DIR=/root/.cache/uv
RUN apk add --no-cache build-base libpq-dev linux-headers git curl rust cargo openssl-dev
ENV PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1 \
    RUSTFLAGS="-C target-feature=-crt-static"
COPY --from=ghcr.io/astral-sh/uv:0.4.30 /uv /usr/local/bin/uv
ENV VIRTUAL_ENV=/opt/venv
RUN uv venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
COPY infrastructure/requirements/requirements-core.txt \
     infrastructure/requirements/requirements-db.txt \
     infrastructure/requirements/requirements-observability.txt /tmp/
RUN uv pip install --no-cache-dir -r /tmp/requirements-core.txt -r /tmp/requirements-db.txt -r /tmp/requirements-observability.txt

# --- STAGE 2: API BUILDER ---
FROM base-builder AS api-builder
WORKDIR /app
COPY infrastructure/requirements/requirements-api.txt /tmp/
RUN uv pip install --no-cache-dir -r /tmp/requirements-api.txt
COPY . .
RUN uv pip install --no-cache-dir .

# --- STAGE 3: PRODUCTION RUNTIME ---
FROM docker.io/library/python:3.12-alpine AS production
ENV PYTHON_JIT=all \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONOPTIMIZE=2 \
    PATH="/opt/venv/bin:$PATH"
RUN apk add --no-cache postgresql-libs curl tini openssl ca-certificates
RUN addgroup -g 1001 Manifold && adduser -D -u 1001 -G Manifold -h /home/Manifold Manifold
WORKDIR /app
COPY --from=api-builder /opt/venv /opt/venv
COPY --from=api-builder /app /app
RUN chown -R Manifold:Manifold /app /opt/venv
USER Manifold
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["granian", "--interface", "asgi", "api.index:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--loop", "uvloop", "--ws"]
