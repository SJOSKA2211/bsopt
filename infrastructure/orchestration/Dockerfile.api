# ==============================================================================
# BSOPT: API Service - OMARCHY ABSOLUTE Hardened (v10.0 - Alpine Multi-Stage)
# ==============================================================================

# --- Stage 1: Build Environment ---
FROM python@sha256:236173eb74001afe2f60862de935b74fcbd00adfca247b2c27051a70a6a39a2d AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache \
    build-base \
    curl \
    git \
    libffi-dev \
    openssl-dev \
    python3-dev

# Install uv 
COPY --from=ghcr.io/astral-sh/uv:0.4 /uv /uvx /bin/

# Copy dependency definitions
COPY pyproject.toml uv.lock ./

# Synchronize dependencies (API specific extras)
RUN uv sync --no-dev --extra api --extra shared --extra observability --frozen

# Copy source and protos
COPY src ./src
COPY protos ./protos

# Generate gRPC manifests
RUN .venv/bin/python -m grpc_tools.protoc -I./protos \
    --python_out=./src/shared/protos \
    --grpc_python_out=./src/shared/protos \
    protos/*.proto

# --- Stage 2: Final Runtime ---
FROM python@sha256:236173eb74001afe2f60862de935b74fcbd00adfca247b2c27051a70a6a39a2d AS final

WORKDIR /app
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

# Install runtime dependencies
RUN apk add --no-cache \
    openssl \
    ca-certificates \
    libstdc++ \
    curl

# Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy build artifacts
COPY --from=builder /build/.venv /app/.venv
COPY --from=builder /build/src /app/src

# Security enforcement
RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "src.api.index:app", "--host", "0.0.0.0", "--port", "8000"]
