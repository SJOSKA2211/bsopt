# ==============================================================================
# EQUAFLOW: API MANIFOLD (v11.1)
# ==============================================================================
# High-performance ASGI gateway for the BSOPT platform.
# Rebased on Institutional Base.
# ==============================================================================

# --- BUILDER ---
FROM equaflow-base:latest AS builder
WORKDIR /app

# Install build-time specific dependencies (Api-specific)
COPY infrastructure/requirements/requirements-api.txt /tmp/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r /tmp/requirements-api.txt

# Copy source + wheel from previous phase (if available) or build here
# To be truly lean, we should copy the pre-built math kernels
COPY . .
RUN uv pip install --system .

# --- DEVELOPMENT ---
FROM equaflow-base:latest AS development
WORKDIR /app

# Copy source + requirements
COPY . .
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

# Install App in editable mode or just system-wide for dev
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system -r infrastructure/requirements/requirements-api.txt && \
    uv pip install --system .

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/entrypoint-shim.sh"]
CMD ["granian", "--interface", "asgi", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--reload"]

# --- FINAL RUNTIME ---
FROM equaflow-base:latest AS production
WORKDIR /app

# Copy only the virtual env if we weren't using --system,
# but since equaflow-base installed to --system, we just rely on that.
# For a "lean" Docker, we should actually use a VENV and COPY it.

# Institutional Security & Performance
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

USER equaflow
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health').read()" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["granian", "--interface", "asgi", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--loop", "uvloop", "--websockets", "--opt"]
