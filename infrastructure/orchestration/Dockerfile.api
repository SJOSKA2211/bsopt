# ==============================================================================
# BSOPT: API Service - Production Hardened (v9.0 - Alpine)
# ==============================================================================

# --- Stage 1: Rust Builder ---
FROM python:3.12.13-alpine AS rust-builder
WORKDIR /build
RUN apk add --no-cache build-base curl openssl-dev pkgconfig git
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:$PATH"
COPY src/math_kernel/rust-core ./rust-core
RUN pip install --no-cache-dir maturin
RUN cd rust-core && maturin build --release --target x86_64-unknown-linux-musl --out /build/wheels

# --- Stage 2: Python Builder ---
FROM python:3.12.13-alpine AS py-builder
WORKDIR /build
RUN apk add --no-cache build-base curl git openssl-dev
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:$PATH"
COPY pyproject.toml .
RUN uv pip install --system --no-cache-dir .[api,shared]
COPY --from=rust-builder /build/wheels/*.whl /tmp/
RUN uv pip install --system --no-cache-dir /tmp/*.whl && rm /tmp/*.whl

COPY src ./src
COPY protos ./protos
RUN python -m grpc_tools.protoc -I./protos --python_out=./src/shared --grpc_python_out=./src/shared ./protos/*.proto

# --- Stage 3: Final Runtime ---
FROM python:3.12.13-alpine
WORKDIR /app
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

RUN apk add --no-cache openssl ca-certificates curl

COPY --from=py-builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=py-builder /usr/local/bin /usr/local/bin
COPY --from=py-builder /build/src /app/src
COPY api /app/api

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 8000
CMD ["uvicorn", "api.index:app", "--host", "0.0.0.0", "--port", "8000"]
