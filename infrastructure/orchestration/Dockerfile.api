# ==============================================================================
# EQUAFLOW: API MANIFOLD (v11.1)
# ==============================================================================
# High-performance ASGI gateway for the BSOPT platform.
# Rebased on Institutional Base.
# ==============================================================================

# --- BUILDER ---
FROM equaflow-base:latest AS builder
WORKDIR /app

# Install build-time specific dependencies (Rust for math kernels)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_BUILD_JOBS=1

COPY pyproject.toml requirements.txt README.md ./
COPY src ./src

# Build Wheel for Rust Core
RUN uv pip install maturin
RUN cd src/math_kernel/rust-core && maturin build --release --strip --out /tmp/wheels

# Install App + Dependencies into venv
RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r requirements.txt && \
    uv pip install granian && \
    uv pip install .[api,ml,quant,distributed] && \
    uv pip install /tmp/wheels/*.whl

# --- DEVELOPMENT ---
FROM equaflow-base:latest AS development
WORKDIR /app

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy everything for dev (hot-reloading via volumes)
COPY . .
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/entrypoint-shim.sh"]
CMD ["granian", "--interface", "asgi", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# --- PRODUCTION ---
FROM equaflow-base:latest AS production
WORKDIR /app

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy source + entrypoint
COPY src ./src
COPY infrastructure/scripts/entrypoint-shim.sh /usr/local/bin/entrypoint-shim.sh
RUN chmod +x /usr/local/bin/entrypoint-shim.sh

# Institutional Security & Performance
USER equaflow
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health').read()" || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-shim.sh"]
CMD ["granian", "--interface", "asgi", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--loop", "uvloop", "--websockets", "--opt"]
