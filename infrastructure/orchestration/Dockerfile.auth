# ==============================================================================
# Manifold: AUTH SERVICE (v12.0) - HARDENED & OPTIMIZED
# ==============================================================================

# Use the pre-built manifold-base stage or image
FROM manifold-base:latest AS builder

USER root
WORKDIR /app

# Install project-specific dependencies
COPY infrastructure/requirements/requirements-auth.txt ./
RUN uv pip install --no-cache-dir -r requirements-auth.txt

# Copy source and install project in editable mode for the venv
COPY . .
RUN uv pip install --no-cache-dir .

# --- STAGE 2: PRODUCTION RUNTIME ---
FROM manifold-base:latest AS production

WORKDIR /app

# Copy the pre-built virtual environment and source from builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# Hardening: Final check on permissions
USER Manifold
EXPOSE 3001

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:3001/health || exit 1

# Start the Auth service
CMD ["python", "src/auth/main.py"]
