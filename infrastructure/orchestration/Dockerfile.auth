# ==============================================================================
# Manifold: AUTH SERVICE (v12.0) - HARDENED & OPTIMIZED
# ==============================================================================

FROM manifold-base:latest

EXPOSE 3001 50051

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD grpc_health_probe -addr=:50051 || exit 1

# Start the Auth server (gRPC + HTTP Health)
CMD ["python", "src/auth/auth_server.py"]
