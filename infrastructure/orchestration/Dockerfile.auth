# Stage 1: Builder
FROM python:3.12.13-slim-bookworm as builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl build-essential && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:$PATH"
COPY pyproject.toml .
# Install dependencies using uv
RUN uv pip install --system --no-cache-dir -r pyproject.toml
COPY src /app/src
COPY protos /app/protos
# --- TLS Certificate Integration ---
RUN mkdir -p /app/certs
COPY infrastructure/configs/auth_service.crt /app/certs/auth_service.crt
COPY infrastructure/configs/auth_service.key /app/certs/auth_service.key
COPY infrastructure/configs/root_ca.crt /app/certs/root_ca.crt
# --- End TLS Certificate Integration ---
# Generate gRPC code if needed
RUN python -m grpc_tools.protoc -I/app/protos --python_out=/app/src/shared --grpc_python_out=/app/src/shared /app/protos/*.proto

# Stage 2: Runtime
FROM python:3.12.13-slim-bookworm
WORKDIR /app
# Copy installed uv binary and libraries from builder stage
COPY --from=builder /root/.cargo /root/.cargo
ENV PATH="/root/.cargo/bin:$PATH"
# Copy installed python packages
COPY --from=builder /root/.venv /root/.venv
# Copy application code and generated proto files
COPY src /app/src
COPY protos /app/protos
# --- TLS Certificate Integration ---
RUN mkdir -p /app/certs
COPY infrastructure/configs/auth_service.crt /app/certs/auth_service.crt
COPY infrastructure/configs/auth_service.key /app/certs/auth_service.key
COPY infrastructure/configs/root_ca.crt /app/certs/root_ca.crt
# --- End TLS Certificate Integration ---

# Expose the port for the authentication gRPC service
EXPOSE 50051
# Command to run the authentication gRPC server with TLS
CMD ["python", "-m", "src.auth.grpc_server", "--tls_cert_path=/app/certs/auth_service.crt", "--tls_key_path=/app/certs/auth_service.key", "--tls_ca_path=/app/certs/root_ca.crt"]
