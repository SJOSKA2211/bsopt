# ==============================================================================
# BSOPT: Auth Service - Production Hardened (v9.0 - Alpine)
# ==============================================================================

# --- Stage 1: Builder ---
FROM python:3.12.13-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache build-base curl git openssl-dev

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:$PATH"

COPY pyproject.toml .

# Install dependencies including auth group
RUN uv pip install --system --no-cache-dir .[auth,shared]

COPY src ./src
COPY protos ./protos

# Generate gRPC code
RUN python -m grpc_tools.protoc -I./protos --python_out=./src/shared --grpc_python_out=./src/shared ./protos/*.proto

# --- Stage 2: Final Runtime ---
FROM python:3.12.13-alpine

WORKDIR /app
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Install runtime dependencies
RUN apk add --no-cache openssl ca-certificates

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /build/src /app/src

# Security: Non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 50051

# Note: Certs are mounted via volumes at /etc/ssl/certs and /etc/ssl/private
CMD ["python", "src/auth/grpc_server.py"]
