# ==============================================================================
# BSOPT: Auth Service - Production Hardened (v9.1 - Alpine)
# ==============================================================================

# --- Stage 1: Builder ---
FROM python:3.12.13-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache build-base curl git openssl-dev

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.cargo/bin:$PATH"

COPY pyproject.toml .

# Create virtualenv and install dependencies
RUN uv venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN uv pip install --no-cache-dir .[auth,shared]

COPY src ./src
COPY protos ./protos

# Generate gRPC code and fix imports
RUN python -m grpc_tools.protoc -I./protos --python_out=./src/shared/protos --grpc_python_out=./src/shared/protos ./protos/*.proto && \
    sed -i 's/^import \([^ ]*\)_pb2/from . import \1_pb2/g' ./src/shared/protos/*_pb2*.py

# --- Stage 2: Final Runtime ---
FROM python:3.12.13-alpine

WORKDIR /app
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/venv/bin:$PATH"

# Install runtime dependencies
RUN apk add --no-cache openssl ca-certificates libstdc++

# Copy virtualenv and source from builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/src /app/src

# Security: Non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 50051

CMD ["python", "src/auth/grpc_server.py"]
