# ==============================================================================
# BSOPT: Auth Service - OMARCHY ABSOLUTE Hardened (v10.0 - Alpine Multi-Stage)
# ==============================================================================

# --- Stage 1: Build Environment ---
# Pinning to exact SHA256 for deterministic builds
FROM python:3.12.13-alpine@sha256:47708573fc0952d763efbe3ba97ddf9693cf7db931e846101c4c81f706935cc5 AS builder

WORKDIR /build

# Install build dependencies for C-extensions and uv
RUN apk add --no-cache \
    build-base \
    curl \
    git \
    libffi-dev \
    openssl-dev \
    python3-dev

# Install uv for high-speed, deterministic dependency management
COPY --from=ghcr.io/astral-sh/uv:0.1.35 /uv /uvx /bin/

# Copy dependency definitions
COPY pyproject.toml uv.lock ./

# Synchronize dependencies with exact hashes from uv.lock
RUN uv sync --no-dev --extra auth --extra shared --frozen

# Copy source and protos
COPY src ./src
COPY protos ./protos

# Generate gRPC manifests
RUN .venv/bin/python -m grpc_tools.protoc -I./protos \
    --python_out=./src/shared/protos \
    --grpc_python_out=./src/shared/protos \
    protos/*.proto && \
    sed -i 's/^import \([^ ]*\)_pb2/from . import \1_pb2/g' ./src/shared/protos/*_pb2*.py

# --- Stage 2: Final Runtime ---
FROM python:3.12.13-alpine@sha256:47708573fc0952d763efbe3ba97ddf9693cf7db931e846101c4c81f706935cc5 AS final

WORKDIR /app
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

# Install runtime dependencies (OpenSSL for mTLS)
RUN apk add --no-cache \
    openssl \
    ca-certificates \
    libstdc++

# Create non-root user (Principle of Least Privilege)
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy only the virtualenv and necessary source from builder
COPY --from=builder /build/.venv /app/.venv
COPY --from=builder /build/src /app/src

# Set ownership and security context
RUN chown -R appuser:appgroup /app
USER appuser

# Expose gRPC port
EXPOSE 50051

# Healthcheck for orchestration
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD nc -z localhost 50051 || exit 1

CMD ["python", "src/auth/grpc_server.py"]
