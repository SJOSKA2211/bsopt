# --- Stage 1: Build Environment ---
FROM python@sha256:236173eb74001afe2f60862de935b74fcbd00adfca247b2c27051a70a6a39a2d AS builder

WORKDIR /build

# Build dependencies
RUN apk add --no-cache build-base curl git libffi-dev openssl-dev python3-dev

# Install uv 
COPY --from=ghcr.io/astral-sh/uv:0.4 /uv /uvx /bin/

# Copy dependency definitions
COPY pyproject.toml uv.lock ./

# Synchronize dependencies with exact hashes from uv.lock
RUN uv sync --no-dev --extra auth --extra shared --frozen

# Copy source and protos
COPY src ./src
COPY protos ./protos

# Generate gRPC manifests
RUN .venv/bin/python -m grpc_tools.protoc -I./protos \
    --python_out=./src/shared/protos \
    --grpc_python_out=./src/shared/protos \
    protos/*.proto && \
    sed -i 's/^import \([a-zA-Z0-9_]*\)_pb2/from . import \1_pb2/g' ./src/shared/protos/*_pb2*.py

# --- Stage 2: Final Runtime ---
FROM python@sha256:236173eb74001afe2f60862de935b74fcbd00adfca247b2c27051a70a6a39a2d AS final

WORKDIR /app
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

# Install runtime dependencies (OpenSSL for mTLS)
RUN apk add --no-cache \
    openssl \
    ca-certificates \
    libstdc++

# Create non-root user (Principle of Least Privilege)
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy only the virtualenv and necessary source from builder
COPY --from=builder /build/.venv /app/.venv
COPY --from=builder /build/src /app/src

# Set ownership and security context
RUN chown -R appuser:appgroup /app
USER appuser

# Expose gRPC port
EXPOSE 50051

# Healthcheck for orchestration
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD nc -z localhost 50051 || exit 1

CMD ["python", "src/auth/grpc_server.py"]
