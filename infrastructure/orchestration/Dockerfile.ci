# ==============================================================================
# Manifold: CI/TEST RUNNER (v12.0)
# ==============================================================================
# High-performance test environment with all optional dependencies.
# ==============================================================================

# --- STAGE 1: BUILDER ---
FROM manifold-base:latest AS builder
USER root
WORKDIR /app

# Install all optional dependencies for full testing
RUN /usr/local/bin/uv pip install --no-cache-dir \
    ".[api,auth,observability,ml,quant,distributed,dev]"

# Copy source
COPY . .
RUN /usr/local/bin/uv pip install --no-cache-dir -e .

# --- STAGE 2: TEST RUNTIME ---
FROM manifold-base:latest AS production
USER root
WORKDIR /app

# Copy the pre-built virtual environment from the builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /app /app

# Environment Settings
ENV ENVIRONMENT=test \
    PYTHONDONTWRITEBYTECODE=1

RUN chown -R Manifold:Manifold /app /opt/venv

USER Manifold

# Entrypoint for running tests
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["pytest", "tests/unit"]
