# ==============================================================================
# EQUAFLOW: CI/TEST RUNNER (v11.1)
# ==============================================================================
# High-fidelity testing environment for the BSOPT platform.
# Rebased on Institutional Base.
# ==============================================================================

# --- BUILDER ---
FROM equaflow-base:latest AS builder
WORKDIR /app

# Install build-time specific dependencies (Rust for math kernels)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_BUILD_JOBS=1

COPY pyproject.toml README.md ./
COPY infrastructure/requirements/ /app/infrastructure/requirements/
COPY . .

# Build Wheel for Rust Core
RUN uv pip install --system maturin
RUN cd src/math_kernel/rust-core && maturin build --release --strip --out /tmp/wheels

# Install App + All Extras (api, auth, ml, quant, distributed, dev)
RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu && \
    uv pip install -r infrastructure/requirements/requirements-core.txt && \
    uv pip install -r infrastructure/requirements/requirements-api.txt && \
    uv pip install -r infrastructure/requirements/requirements-db.txt && \
    uv pip install -r infrastructure/requirements/requirements-ml.txt && \
    uv pip install -r infrastructure/requirements/requirements-worker.txt && \
    uv pip install -r infrastructure/requirements/requirements-scraper.txt && \
    uv pip install -r infrastructure/requirements/requirements-auth.txt && \
    uv pip install -r infrastructure/requirements/requirements-observability.txt && \
    uv pip install .[dev] && \
    uv pip install /tmp/wheels/*.whl

# --- RUNNER ---
FROM equaflow-base:latest
WORKDIR /app

# Copy virtualenv from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy entire project for testing
COPY . .

# Set testing environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    BSOPT_TEST_MODE=1 \
    PYTHONPATH=/app \
    NUMBA_DISABLE_JIT=1

# Default command for CI/Test runs
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["pytest", "tests/"]
