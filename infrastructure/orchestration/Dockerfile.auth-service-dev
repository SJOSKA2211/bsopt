# Auth Service — Python Development
FROM docker.io/library/python:3.12-slim-bookworm
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev gcc git curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv
ENV UV_HTTP_TIMEOUT=30000 \
    UV_CONCURRENT_DOWNLOADS=2 \
    UV_RETRIES=10
ENV UV_RETRIES=10
COPY pyproject.toml requirements.txt ./
RUN /usr/local/bin/uv pip install --retries 10 --no-cache-dir --system --no-cache -r requirements.txt

COPY src /app/src
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 3001
CMD ["python", "-m", "src.auth.auth_server"]
