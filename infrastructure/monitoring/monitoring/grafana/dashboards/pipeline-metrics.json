      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "expr": "sum(rate(bsopt_ingestion_ticks_total[5m]))", "legendFormat": "Ticks/sec", "refId": "A" }
      ],
      "title": "Ingestion Rate (ticks/sec)",
      "type": "stat"
    },
    {
      "datasource": "prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "expr": "sum(rate(bsopt_ingestion_options_total[5m]))", "legendFormat": "Options/sec", "refId": "A" }
      ],
      "title": "Options Ingestion Rate",
      "type": "stat"
    },
    {
      "datasource": "prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "green", "value": 5 }
          ]}
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "expr": "bsopt_active_ingestion_tasks", "legendFormat": "Active Tasks", "refId": "A" }
      ],
      "title": "Active Ingestion Tasks",
      "type": "stat"
    },
    {
      "datasource": "prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "targets": [
        { "expr": "sum(rate(bsopt_ingestion_errors_total[5m])) by (type)", "legendFormat": "{{type}}", "refId": "A" }
      ],
      "title": "Ingestion Errors/sec",
      "type": "stat"
    },
    {
      "datasource": "prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "expr": "job:ingestion_latency:p99", "legendFormat": "p99", "refId": "A" }
      ],
      "title": "Batch Ingestion Latency (p99 - Optimized)",
      "type": "timeseries"
    },
    {
      "datasource": "prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
